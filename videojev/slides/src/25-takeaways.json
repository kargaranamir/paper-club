[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Takeaways","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART IV · DISCUSSION","fontSize":17,"strokeColor":"#6b6f76","id":"e2"},{"type":"rectangle","x":70,"y":150,"width":1460,"height":106,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":95,"y":164,"text":"1 · Score, don't write","fontSize":26,"strokeColor":"#2c68c9","id":"e4"},{"type":"text","x":95,"y":202,"text":"For spans and choices, scoring beats generating: +6.7 / +10.8 mIoU over the backbones,\n+1.3 over autoregressive fine-tuning on the same data.","fontSize":20,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":70,"y":272,"width":1460,"height":106,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":95,"y":286,"text":"2 · Encode the video once","fontSize":26,"strokeColor":"#2f8a3d","id":"e7"},{"type":"text","x":95,"y":324,"text":"Joint inference: ten questions cost almost the same as one (+55 ms grounding, +31 ms QA).","fontSize":21,"strokeColor":"#1e1e1e","id":"e8"},{"type":"rectangle","x":70,"y":394,"width":1460,"height":106,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":95,"y":408,"text":"3 · Close to Thinking without thinking","fontSize":26,"strokeColor":"#6a45c9","id":"e10"},{"type":"text","x":95,"y":446,"text":"Video QA within 0.6 points of, or above, Thinking mode, at about 1/100 of the time.","fontSize":21,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":70,"y":516,"width":1460,"height":106,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e12"},{"type":"text","x":95,"y":530,"text":"4 · Training choices matter","fontSize":26,"strokeColor":"#b5690b","id":"e13"},{"type":"text","x":95,"y":568,"text":"Soft IoU is worth +4.6 mIoU; training grounding and QA together helps both tasks (+0.7 / +1.3).","fontSize":21,"strokeColor":"#1e1e1e","id":"e14"},{"type":"rectangle","x":70,"y":638,"width":1460,"height":106,"strokeColor":"#e8590c","backgroundColor":"#fff1e8","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e15"},{"type":"text","x":95,"y":652,"text":"5 · Confidence is a bonus, not yet reliable","fontSize":26,"strokeColor":"#c2410c","id":"e16"},{"type":"text","x":95,"y":690,"text":"High confidence predicts correctness, but the probabilities are overconfident (ECE ≈ 8 points).","fontSize":21,"strokeColor":"#1e1e1e","id":"e17"},{"type":"text","x":70,"y":775,"text":"arxiv.org/abs/2610.18615  ·  github.com/MCG-NJU/VideoJev","fontSize":21,"strokeColor":"#6b6f76","fontFamily":8,"id":"e18"},{"type":"text","x":1516.3,"y":856.8,"text":"25","fontSize":18,"strokeColor":"#adb5bd","id":"e19"}]