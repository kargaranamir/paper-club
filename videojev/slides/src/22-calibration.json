[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Confidence: useful for ranking, not yet calibrated","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART III · RESULTS","fontSize":17,"strokeColor":"#6a45c9","id":"e2"},{"type":"rectangle","x":70,"y":170,"width":715,"height":300,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":95,"y":188,"text":"High confidence → high accuracy","fontSize":25,"strokeColor":"#2f8a3d","id":"e4"},{"type":"rectangle","x":440,"y":260,"width":176.2,"height":46,"strokeColor":"#ced4da","backgroundColor":"#f1f3f5","fillStyle":"solid","strokeWidth":2,"id":"e5"},{"type":"text","x":259.5,"y":271.1,"text":"all 1,549 questions","fontSize":19,"strokeColor":"#1e1e1e","id":"e6"},{"type":"text","x":626.2,"y":270.5,"text":"73.4%","fontSize":20,"strokeColor":"#1e1e1e","id":"e7"},{"type":"rectangle","x":440,"y":340,"width":229.9,"height":46,"strokeColor":"#5cbf6a","backgroundColor":"#d9f5dc","fillStyle":"solid","strokeWidth":2,"id":"e8"},{"type":"text","x":180.2,"y":351.1,"text":"591 with confidence ≥ 99%","fontSize":19,"strokeColor":"#1e1e1e","id":"e9"},{"type":"text","x":679.9,"y":350.5,"text":"95.8%","fontSize":20,"strokeColor":"#1e1e1e","id":"e10"},{"type":"text","x":95,"y":430,"text":"VideoJev-35B-A3B on LVBench","fontSize":18,"strokeColor":"#6b6f76","id":"e11"},{"type":"rectangle","x":815,"y":170,"width":715,"height":300,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e12"},{"type":"text","x":840,"y":188,"text":"But probabilities are overconfident","fontSize":25,"strokeColor":"#b5690b","id":"e13"},{"type":"text","x":840,"y":238,