[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"The System One idea (Jev)","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":108,"text":"Fast typed judgments instead of slow free text","fontSize":26,"strokeColor":"#6b6f76","id":"e2"},{"type":"text","x":72,"y":14,"text":"PART I · BACKGROUND","fontSize":17,"strokeColor":"#495057","id":"e3"},{"type":"rectangle","x":70,"y":160,"width":715,"height":300,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e4"},{"type":"text","x":95,"y":178,"text":"System 2: slow, deliberate","fontSize":26,"strokeColor":"#b5690b","id":"e5"},{"type":"text","x":95,"y":228,"text":"a chat LLM: writes free text token by\ntoken, can reason, plan, explain;\noutput must be parsed by software","fontSize":22,"strokeColor":"#1e1e1e","id":"e6"},{"type":"rectangle","x":815,"y":160,"width":715,"height":300,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e7"},{"type":"text","x":840,"y":178,"text":"System 1: fast, intuitive","fontSize":26,"strokeColor":"#2c68c9","id":"e8"},{"type":"text","x":840,"y":228,"text":"a System One model: returns a typed\ndecision (a choice, a yes/no, a score)\nwith probabilities, in one pass","fontSize":22,"strokeColor":"#1e1e1e","id":"e9"},{"type":"text","x":70,"y":490,"text":"Jev (TypeSafe AI)","fontSize":24,"strokeColor":"#1e1e1e","id":"e10"},{"type":"text","x":70,"y":530,"text":"• typed probabilistic judgments that software can use directly\n• trained with RL for calibrated probabilities\n• 'Jev' after the economist Jevons: cheaper decisions → many more uses\n• image versions: Visual Jev, PixelJev → this paper: video","fontSize":22,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":900,"y":490,"width":630,"height":220,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e12"},{"type":"text","x":920,"y":508,"text":"The paper's premise","fontSize":23,"strokeColor":"#1e1e1e","id":"e13"},{"type":"text","x":920,"y":550,"text":"\"Structured visual judgments can\nsupport open-ended behavior without\nrequiring open-ended generation at\nevery step.\"","fontSize":22,"strokeColor":"#1e1e1e","id":"e14"},{"type":"text","x":70,"y":857.4,"text":"VideoJev (arXiv:2610.18615), §1 and §4; TypeSafe AI blog (vendor description of Jev)","fontSize":17,"strokeColor":"#6b6f76","id":"e15"},{"type":"text","x":1530,"y":856.8,"text":"7","fontSize":18,"strokeColor":"#adb5bd","id":"e16"}]