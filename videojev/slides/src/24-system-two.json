[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Where this fits: System 2 asks, System 1 checks","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART III · RESULTS","fontSize":17,"strokeColor":"#6a45c9","id":"e2"},{"type":"rectangle","x":70,"y":180,"width":470,"height":380,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":95,"y":198,"text":"System 2: planner","fontSize":26,"strokeColor":"#b5690b","id":"e4"},{"type":"text","x":95,"y":248,"text":"an LLM agent or a fixed\nprocedure:\n\n• breaks a goal into checks\n• proposes candidate events,\n  actions or states\n• reasons when results are\n  ambiguous","fontSize":21,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":1060,"y":180,"width":470,"height":380,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":1085,"y":198,"text":"System 1: VideoJev","fontSize":26,"strokeColor":"#2c68c9","id":"e7"},{"type":"text","x":1085,"y":248,"text":"scores each candidate against\nthe video, fast, with\nprobabilities:\n\n• when did X happen?\n• which of A, B, C is true?","fontSize":21,"strokeColor":"#1e1e1e","id":"e8"},{"type":"arrow","x":545,"y":300,"width":510,"height":0,"points":[[0,0],[510,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e9"},{"type":"text","x":687.5,"y":270,"text":"questions + candidates","fontSize":20,"strokeColor":"#1e1e1e","id":"e10"},{"type":"arrow","x":1055,"y":430,"width":510,"height":0,"points":[[0,0],[-510,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e11"},{"type":"text","x":672.8,"y":400,"text":"spans, options, confidence","fontSize":20,"strokeColor":"#1e1e1e","id":"e12"},{"type":"text","x":711.6,"y":470,"text":"uncertain → escalate","fontSize":18,"strokeColor":"#b5690b","id":"e13"},{"type":"text","x":70,"y":610,"text":"\"System Two organizes the decision space, while System One evaluates it against visual evidence.\"","fontSize":24,"strokeColor":"#2c68c9","id":"e14"},{"type":"text","x":70,"y":670,"text":"Applications named: procedural monitoring, interactive assistance, embodied agents, computer use. Next steps: more\ntask types (action recognition, event detection), streaming input, better calibration.","fontSize":20,"strokeColor":"#6b6f76","id":"e15"},{"type":"text","x":70,"y":857.4,"text":"VideoJev (arXiv:2610.18615), §5 (future work; not evaluated in the paper)","fontSize":17,"strokeColor":"#6b6f76","id":"e16"},{"type":"text","x":1516.9,"y":856.8,"text":"24","fontSize":18,"strokeColor":"#adb5bd","id":"e17"}]