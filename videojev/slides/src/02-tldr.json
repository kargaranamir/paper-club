[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"The paper in one slide","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"rectangle","x":70,"y":160,"width":465,"height":555,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e2"},{"type":"text","x":92,"y":176,"text":"Problem","fontSize":32,"strokeColor":"#b5690b","id":"e3"},{"type":"text","x":92,"y":230,"text":"Video MLLMs answer by writing\ntext token by token, even when the\nanswer is a time span or 'B'.\n\n• slow: 'Thinking' takes 145 s\n  per question (Qwen3.5-4B)\n• output must be parsed\n• an agent asks many questions\n  about the same video","fontSize":23,"strokeColor":"#1e1e1e","id":"e4"},{"type":"rectangle","x":565,"y":160,"width":465,"height":555,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e5"},{"type":"text","x":587,"y":176,"text":"Idea","fontSize":32,"strokeColor":"#2c68c9","id":"e6"},{"type":"text","x":587,"y":230,"text":"A System One head on an MLLM:\nscore candidates in one pass.\n\n• grounding: score every short\n  time interval → pick a span\n• QA: score every option → softmax\n• video encoded once, many\n  questions in one forward pass","fontSize":23,"strokeColor":"#1e1e1e","id":"e7"},{"type":"rectangle","x":1060,"y":160,"width":465,"height":555,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e8"},{"type":"text","x":1082,"y":176,"text":"Evidence","fontSize":32,"strokeColor":"#2f8a3d","id":"e9"},{"type":"text","x":1082,"y":230,"text":"Grounding, mean mIoU:\n• 4B: 58.6 → 65.3 (+6.7)\n• 35B-A3B: 56.9 → 67.7 (+10.8)\n• 2.8–3.1× faster than backbone\n\nVideo QA, 4-benchmark mean:\n• about equal to 'Thinking'\n  (74.3 vs 74.9; 79.5 vs 78.8)\n• 100–129× faster","fontSize":23,"strokeColor":"#1e1e1e","id":"e10"},{"type":"rectangle","x":70,"y":740,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e11"},{"type":"text","x":368.4,"y":755.8,"text":"Many video questions do not need a written answer, only a decision.","fontSize":26,"strokeColor":"#1e1e1e","id":"e12"},{"type":"text","x":70,"y":857.4,"text":"VideoJev (arXiv:2610.18615): abstract, Tables 1 and 2","fontSize":17,"strokeColor":"#6b6f76","id":"e13"},{"type":"text","x":1527.4,"y":856.8,"text":"2","fontSize":18,"strokeColor":"#adb5bd","id":"e14"}]