   "versionNonce": 216965643,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Decoding rule",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Decoding rule",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e43",
   "type": "text",
   "x": 950,
   "y": 238,
   "width": 367.3311767578125,
   "height": 200,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "ah",
   "roundness": null,
   "seed": 1044056605,
   "version": 1,
   "versionNonce": 888217498,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. shift each logit by the threshold:\n    aᵢ = sᵢ − logit(τ)\n    (aᵢ > 0 exactly when pᵢ > τ)\n2. pick the contiguous range with the\n    largest sum of aᵢ (Kadane, O(K))\n3. its interval boundaries are the\n    answer; if all aᵢ < 0, take the best\n    single interval",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1. shift each logit by the threshold:\n    aᵢ = sᵢ − logit(τ)\n    (aᵢ > 0 exactly when pᵢ > τ)\n2. pick the contiguous range with the\n    largest sum of aᵢ (Kadane, O(K))\n3. its interval boundaries are the\n    answer; if all aᵢ < 0, take the best\n    single interval",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e44",
   "type": "text",
   "x": 70,
   "y": 615,
   "width": 807.759765625,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "ai",
   "roundness": null,
   "seed": 926613272,
   "version": 1,
   "versionNonce": 752863713,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "shifted logits aᵢ:  -4.0  -3.4  -2.5  +3.3  +5.5  +5.6  +5.7  +5.3  +2.7  +0.4",
   "fontSize": 19,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "shifted logits aᵢ:  -4.0  -3.4  -2.5  +3.3  +5.5  +5.6  +5.7  +5.3  +2.7  +0.4",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e45",
   "type": "text",
   "x": 70,
   "y": 660,
   "width": 1060.879150390625,
   "height": 50,
   "angle": 0,
   "strokeColor": "#6b6f76",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aj",
   "roundness": null,
   "seed": 943390891,
   "version": 1,
   "versionNonce": 216127000,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The last interval (p = 0.33) is still above τ, so the span runs to the end of the clip. τ = 0.25 is fixed for all\nexperiments and both model sizes.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The last interval (p = 0.33) is still above τ, so the span runs to the end of the clip. τ = 0.25 is fixed for all\nexperiments and both model sizes.",
   "autoResize": true,
   "lineHeight": 1.25
  },
