   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Grounding, mean mIoU:\n• 4B: 58.6 → 65.3 (+6.7)\n• 35B-A3B: 56.9 → 67.7 (+10.8)\n• 2.8–3.1× faster than backbone\n\nVideo QA, 4-benchmark mean:\n• about equal to 'Thinking'\n  (74.3 vs 74.9; 79.5 vs 78.8)\n• 100–129× faster",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Grounding, mean mIoU:\n• 4B: 58.6 → 65.3 (+6.7)\n• 35B-A3B: 56.9 → 67.7 (+10.8)\n• 2.8–3.1× faster than backbone\n\nVideo QA, 4-benchmark mean:\n• about equal to 'Thinking'\n  (74.3 vs 74.9; 79.5 vs 78.8)\n• 100–129× faster",
   "autoResize": true,
   "lineHeight": 1.25
  },
