   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Video MLLMs answer by writing\ntext token by token, even when the\nanswer is a time span or 'B'.\n\n• slow: 'Thinking' takes 145 s\n  per question (Qwen3.5-4B)\n• output must be parsed\n• an agent asks many questions\n  about the same video",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Video MLLMs answer by writing\ntext token by token, even when the\nanswer is a time span or 'B'.\n\n• slow: 'Thinking' takes 145 s\n  per question (Qwen3.5-4B)\n• output must be parsed\n• an agent asks many questions\n  about the same video",
   "autoResize": true,
   "lineHeight": 1.25
  },
