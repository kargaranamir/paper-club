   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A System One head on an MLLM:\nscore candidates in one pass.\n\n• grounding: score every short\n  time interval → pick a span\n• QA: score every option → softmax\n• video encoded once, many\n  questions in one forward pass",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A System One head on an MLLM:\nscore candidates in one pass.\n\n• grounding: score every short\n  time interval → pick a span\n• QA: score every option → softmax\n• video encoded once, many\n  questions in one forward pass",
   "autoResize": true,
   "lineHeight": 1.25
  },
