   "versionNonce": 1536905981,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "label yᵢ = 1 if the pair's middle time lies inside the annotated event (here 11–19 s)",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "label yᵢ = 1 if the pair's middle time lies inside the annotated event (here 11–19 s)",
   "autoResize": true,
   "lineHeight": 1.25
  },
