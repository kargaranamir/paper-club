   "index": "b0H",
   "roundness": null,
   "seed": 876773285,
   "version": 1,
   "versionNonce": 1269744005,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "rewards covering the whole event, penalises\nprobability outside it, weighted by duration dᵢ:\n\nL_IoU = 1 − Σ dᵢpᵢyᵢ / Σ dᵢ[yᵢ + pᵢ(1−yᵢ)]",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "rewards covering the whole event, penalises\nprobability outside it, weighted by duration dᵢ:\n\nL_IoU = 1 − Σ dᵢpᵢyᵢ / Σ dᵢ[yᵢ + pᵢ(1−yᵢ)]",
   "autoResize": true,
   "lineHeight": 1.25
  },
