   "locked": false,
   "text": "Loss 1: binary cross-entropy",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Loss 1: binary cross-entropy",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e76",
   "type": "text",
   "x": 95,
   "y": 510,
   "width": 433.3121032714844,
   "height": 105,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
