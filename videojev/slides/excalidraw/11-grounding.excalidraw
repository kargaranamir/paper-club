   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "candidates: timestamp text of each frame pair (copied from the video prefix)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e71",
   "type": "text",
   "x": 70,
   "y": 306,
   "width": 752.3751220703125,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#6a45c9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
