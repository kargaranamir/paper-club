   "index": "b0E",
   "roundness": null,
   "seed": 725774714,
   "version": 1,
   "versionNonce": 1939370159,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "each interval judged on its own, multi-label\n(several can be positive):\n\nL_BCE = mean over i of BCE(pᵢ, yᵢ)",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "each interval judged on its own, multi-label\n(several can be positive):\n\nL_BCE = mean over i of BCE(pᵢ, yᵢ)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
