   "link": null,
   "locked": false,
   "text": "Loss 2: soft IoU (stage 2, weight 2)",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Loss 2: soft IoU (stage 2, weight 2)",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e79",
   "type": "text",
   "x": 840,
   "y": 510,
   "width": 473.49700927734375,
   "height": 105,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
