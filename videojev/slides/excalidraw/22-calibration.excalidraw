   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Jev is trained with reinforcement learning to output calibrated probabilities; VideoJev is not.\nThe authors suggest temperature scaling on held-out data or calibration-aware training.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Jev is trained with reinforcement learning to output calibrated probabilities; VideoJev is not.\nThe authors suggest temperature scaling on held-out data or calibration-aware training.",
