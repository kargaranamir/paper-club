   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• typed probabilistic judgments that software can use directly\n• trained with RL for calibrated probabilities\n• named after Kahneman's System 1 and the economist Jevons\n• image versions: Visual Jev, PixelJev → this paper: video",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "• typed probabilistic judgments that software can use directly\n• trained with RL for calibrated probabilities\n• named after Kahneman's System 1 and the economist Jevons\n• image versions: Visual Jev, PixelJev → this paper: video",
   "autoResize": true,
   "lineHeight": 1.25
  },
