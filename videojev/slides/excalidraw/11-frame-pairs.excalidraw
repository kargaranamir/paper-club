   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "one candidate = 2 / fps seconds: 0.5 s at 4 fps, 1 s at 2 fps\nboundaries fall halfway between neighbouring pairs\na 2-minute video at 4 fps → 480 frames → 240 candidates",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "one candidate = 2 / fps seconds: 0.5 s at 4 fps, 1 s at 2 fps\nboundaries fall halfway between neighbouring pairs\na 2-minute video at 4 fps → 480 frames → 240 candidates",
   "autoResize": true,
   "lineHeight": 1.25
  },
