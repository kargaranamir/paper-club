   "versionNonce": 1635021897,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "frame 1 and frame 2 share their visual tokens:\nthe LLM never sees them apart, so a single-frame\ncandidate would have nothing of its own to point to",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "frame 1 and frame 2 share their visual tokens:\nthe LLM never sees them apart, so a single-frame\ncandidate would have nothing of its own to point to",
   "autoResize": true,
   "lineHeight": 1.25
  },
