roundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e25"},{"type":"text","x":1014.4,"y":419.9,"text":"sdh · Southern Kurdish","fontSize":21,"strokeColor":"#2c68c9","id":"e26"},{"type":"text","x":830,"y":495,"text":"Limited mutual intelligibility, Latin and\nArabic-based scripts: an unqualified\n'Kurdish' in a paper is ambiguous.","fontSize":21,"strokeColor":"#1e1e1e","id":"e27"},{"type":"rectangle","x":70,"y":615,"width":1460,"height":110,"strokeColor":"#ced4da","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e28"},{"type":"text","x":95,"y":630,"text":"Language or dialect?","fontSize":24,"strokeColor":"#495057","id":"e29"},{"type":"text","x":95,"y":668,"text":"Laki: a Kurdish dialect to some, a separate language to others.  Bakhtiari: its own code, yet Persian speakers\nsometimes treat all Luri as Persian.  These choices decide what data is labelled and who gets tools.","fontSize":20,"strokeColor":"#1e1e1e","id":"e30"},{"type":"rectangle","x":70,"y":745,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e31"},{"type":"text","x":285.5,"y":760.8,"text":"A model trained on 'fas' or 'Kurdish' may not serve the people the label suggests.","fontSize":26,"strokeColor":"#1e1e1e","id":"e32"},{"type":"text","x":70,"y":857.4,"text":"Computationally Invisible (SilkRoadNLP submission), §2.1","fontSize":17,"strokeColor":"#6b6f76","id":"e33"},{"type":"text","x":1528.5,"y":856.8,"text":"6","fontSize":18,"strokeColor":"#adb5bd","id":"e34"}]