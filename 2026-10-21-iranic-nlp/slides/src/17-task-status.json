,"strokeColor":"transparent","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":1,"id":"e27"},{"type":"text","x":82,"y":644.8,"text":"NER, classification,\nsummarization","fontSize":21,"strokeColor":"#2f8a3d","id":"e28"},{"type":"text","x":355,"y":658.5,"text":"well studied","fontSize":20,"strokeColor":"#1e1e1e","id":"e29"},{"type":"text","x":955,"y":658.5,"text":"no annotated data","fontSize":20,"strokeColor":"#c2410c","id":"e30"},{"type":"rectangle","x":70,"y":760,"width":1460,"height":58,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e31"},{"type":"text","x":366.2,"y":772.8,"text":"For most varieties, the first dataset of any kind is still to be built.","fontSize":26,"strokeColor":"#1e1e1e","id":"e32"},{"type":"text","x":70,"y":857.4,"text":"Computationally Invisible (SilkRoadNLP submission), §5","fontSize":17,"strokeColor":"#6b6f76","id":"e33"},{"type":"text","x":1522.3,"y":856.8,"text":"17","fontSize":18,"strokeColor":"#adb5bd","id":"e34"}]