[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Transfer from relatives: the main strategy","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART V · TASKS","fontSize":17,"strokeColor":"#2f8a3d","id":"e2"},{"type":"rectangle","x":70,"y":160,"width":465,"height":270,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":92,"y":176,"text":"lexical proximity","fontSize":28,"strokeColor":"#b5690b","id":"e4"},{"type":"text","x":92,"y":225,"text":"Persian, Dari and Tajik share most\nvocabulary: strong zero-shot transfer,\ngiven correct script normalization","fontSize":22,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":565,"y":160,"width":465,"height":270,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":587,"y":176,"text":"script proximity","fontSize":28,"strokeColor":"#2c68c9","id":"e7"},{"type":"text","x":587,"y":225,"text":"all Perso-Arabic varieties share\ntokenization conventions, but Unicode\ndifferences silently degrade transfer","fontSize":22,"strokeColor":"#1e1e1e","id":"e8"},{"type":"rectangle","x":1060,"y":160,"width":465,"height":270,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":1082,"y":176,"text":"grammatical proximity","fontSize":28,"strokeColor":"#2f8a3d","id":"e10"},{"type":"text","x":1082,"y":225,"text":"varieties in one branch share\nmorphology, e.g. Kurmanji → Sorani MT;\nscript normalization helps Kurdish","fontSize":22,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":70,"y":470,"width":1460,"height":240,"strokeColor":"#ced4da","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e12"},{"type":"text","x":95,"y":485,"text":"In practice","fontSize":26,"strokeColor":"#495057","id":"e13"},{"type":"text","x":95,"y":530,"text":"• cross-lingual transfer runs almost entirely through Persian or English as pivots\n• a multilingual model that covers Persian does not cover Dari unless Dari data was included\n• tokenizers are calibrated for high-resource languages and over-segment related varieties\n• systematic intra-family transfer studies are still lacking","fontSize":22,"strokeColor":"#1e1e1e","id":"e14"},{"type":"rectangle","x":70,"y":745,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e15"},{"type":"text","x":338.7,"y":760.8,"text":"Relatedness is an asset, but nobody has measured it systematically yet.","fontSize":26,"strokeColor":"#1e1e1e","id":"e16"},{"type":"text","x":70,"y":857.4,"text":"Computationally Invisible (SilkRoadNLP submission), §6 and §7","fontSize":17,"strokeColor":"#6b6f76","id":"e17"},{"type":"text","x":1521,"y":856.8,"text":"19","fontSize":18,"strokeColor":"#adb5bd","id":"e18"}]