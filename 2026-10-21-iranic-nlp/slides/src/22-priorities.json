[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Three things the community can do now","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART VI · CHALLENGES AND PRIORITIES","fontSize":17,"strokeColor":"#c2410c","id":"e2"},{"type":"rectangle","x":70,"y":160,"width":465,"height":450,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":92,"y":176,"text":"1 · Raw text","fontSize":30,"strokeColor":"#b5690b","id":"e4"},{"type":"text","x":92,"y":227.5,"text":"Put Iranic text on the open web,\nin identifiable form.\n\nWeb crawls feed every corpus;\nuntagged or mistagged text is\ninvisible to LID-filtered\npipelines.","fontSize":24,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":565,"y":160,"width":465,"height":450,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":587,"y":176,"text":"2 · Translation benchmarks","fontSize":30,"strokeColor":"#2c68c9","id":"e7"},{"type":"text","x":587,"y":227.5,"text":"Contribute to FLORES+ / OLDI.\n\nFLORES+ grew from about 200\nto 230 varieties, but still has\nthe same 6 Iranic ones as\nFLORES-200: pes, prs, tgk,\nckb, kmr, pbt.","fontSize":24,"strokeColor":"#1e1e1e","id":"e8"},{"type":"rectangle","x":1060,"y":160,"width":465,"height":450,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":1082,"y":176,"text":"3 · Evaluation beyond MT","fontSize":30,"strokeColor":"#2f8a3d","id":"e10"},{"type":"text","x":1082,"y":227.5,"text":"At least one natively written\nbenchmark per variety.\n\nShared tasks are the most\nplausible way to get them.","fontSize":24,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":70,"y":630,"width":1460,"height":90,"strokeColor":"#ced4da","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e12"},{"type":"text","x":95,"y":645,"text":"About 2K sentences per variety and an open pull-request process: the bottleneck is people, not\ninfrastructure. The lesson from African NLP: community shared tasks and data hubs catalyse progress.","fontSize":20,"strokeColor":"#1e1e1e","id":"e13"},{"type":"rectangle","x":70,"y":745,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e14"},{"type":"text","x":430.1,"y":760.8,"text":"None of these needs a new model; they need contributors.","fontSize":26,"strokeColor":"#1e1e1e","id":"e15"},{"type":"text","x":70,"y":857.4,"text":"Computationally Invisible (SilkRoadNLP submission), §7 (priorities box)","fontSize":17,"strokeColor":"#6b6f76","id":"e16"},{"type":"text","x":1514.8,"y":856.8,"text":"22","fontSize":18,"strokeColor":"#adb5bd","id":"e17"}]