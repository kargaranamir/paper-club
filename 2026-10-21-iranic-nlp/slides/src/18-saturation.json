[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Persian: saturating and still open","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART V · TASKS","fontSize":17,"strokeColor":"#2f8a3d","id":"e2"},{"type":"rectangle","x":70,"y":160,"width":700,"height":300,"strokeColor":"#ced4da","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":92,"y":176,"text":"Approaching saturation","fontSize":28,"strokeColor":"#495057","id":"e4"},{"type":"text","x":92,"y":225,"text":"• standard sentiment classification\n• Wikipedia-based reading comprehension\n• named entity recognition\n\nMany benchmarks are translated from\nEnglish (ParSQuAD from SQuAD).","fontSize":22,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":830,"y":160,"width":700,"height":300,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":852,"y":176,"text":"Open frontiers","fontSize":28,"strokeColor":"#2f8a3d","id":"e7"},{"type":"text","x":852,"y":225,"text":"• cultural and pragmatic competence\n• multi-hop reasoning\n• code-switching\n• robustness to dialects and colloquial\n  Persian (HarfoSokhan: 6M colloquial→\n  formal pairs)","fontSize":22,"strokeColor":"#1e1e1e","id":"e8"},{"type":"rectangle","x":70,"y":490,"width":1460,"height":220,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":95,"y":505,"text":"Example: taarof (ritual politeness)","fontSize":26,"strokeColor":"#b5690b","id":"e10"},{"type":"text","x":95,"y":550,"text":"TaarofBench: LLMs score 40–48% below native Persian speakers on taarof scenarios.\nFrontier models do well on factual recall but show gaps in cultural knowledge and pragmatic judgment\n(Khayyam, FarsEval-PKBETS, ELAB). Taarof is absent from all existing evaluation frameworks.","fontSize":22,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":70,"y":745,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e12"},{"type":"text","x":339.8,"y":760.8,"text":"Persian needs new kinds of tests; the other varieties need a first test.","fontSize":26,"strokeColor":"#1e1e1e","id":"e13"},{"type":"text","x":70,"y":857.4,"text":"Computationally Invisible (SilkRoadNLP submission), §5–§7","fontSize":17,"strokeColor":"#6b6f76","id":"e14"},{"type":"text","x":1520.9,"y":856.8,"text":"18","fontSize":18,"strokeColor":"#adb5bd","id":"e15"}]