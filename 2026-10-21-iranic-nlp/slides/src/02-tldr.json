[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Our survey in one slide","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"rectangle","x":70,"y":160,"width":465,"height":560,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e2"},{"type":"text","x":92,"y":176,"text":"Question","fontSize":32,"strokeColor":"#2c68c9","id":"e3"},{"type":"text","x":92,"y":230,"text":"Where does NLP stand for the\nIranic language family?\n\n• 101 ISO 639-3 coded varieties\n• over 200 million speakers\n• from the Caucasus to Xinjiang,\n  from Russia to Oman\n• four living branches","fontSize":25,"strokeColor":"#1e1e1e","id":"e4"},{"type":"rectangle","x":565,"y":160,"width":465,"height":560,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e5"},{"type":"text","x":587,"y":176,"text":"What we did","fontSize":32,"strokeColor":"#6a45c9","id":"e6"},{"type":"text","x":587,"y":230,"text":"A systematic survey:\n\n• 5,878 candidate papers,\n  2020 – May 2026\n• LLM filter + annotation\n  (Qwen3.5-9B), checked by\n  two of us\n• 495 papers kept\n• audit of corpora, Wikipedia,\n  morphology, LID, parallel data","fontSize":25,"strokeColor":"#1e1e1e","id":"e7"},{"type":"rectangle","x":1060,"y":160,"width":465,"height":560,"strokeColor":"#e8590c","backgroundColor":"#fff1e8","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e8"},{"type":"text","x":1082,"y":176,"text":"What we found","fontSize":32,"strokeColor":"#c2410c","id":"e9"},{"type":"text","x":1082,"y":230,"text":"Severe imbalance:\n\n• Persian: 394 papers (80%)\n• Pashto: 51M speakers, 29 papers\n• Balochi: 9M speakers, 4 papers\n• most varieties: nothing found\n\nPersian itself is saturating on\nstandard tasks; the rest need\ntheir first benchmark.","fontSize":25,"strokeColor":"#1e1e1e","id":"e10"},{"type":"rectangle","x":70,"y":745,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e11"},{"type":"text","x":278.9,"y":760.8,"text":"Iranic NLP is mostly Persian NLP; the other varieties are computationally invisible.","fontSize":26,"strokeColor":"#1e1e1e","id":"e12"},{"type":"text","x":70,"y":857.4,"text":"Computationally Invisible (SilkRoadNLP submission): abstract, §1, §3, §8","fontSize":17,"strokeColor":"#6b6f76","id":"e13"},{"type":"text","x":1527.4,"y":856.8,"text":"2","fontSize":18,"strokeColor":"#adb5bd","id":"e14"}]