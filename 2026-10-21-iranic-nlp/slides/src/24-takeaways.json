[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Takeaways","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART VII · DISCUSSION","fontSize":17,"strokeColor":"#6b6f76","id":"e2"},{"type":"rectangle","x":70,"y":150,"width":1460,"height":106,"strokeColor":"#e8590c","backgroundColor":"#fff1e8","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":95,"y":164,"text":"1 · One variety gets the attention","fontSize":26,"strokeColor":"#c2410c","id":"e4"},{"type":"text","x":95,"y":204,"text":"Iranian Persian: 394 of 495 papers (80%). Pashto (51M) has 29, Balochi (9M) has 4.","fontSize":21,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":70,"y":272,"width":1460,"height":106,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":95,"y":286,"text":"2 · The gap starts below the papers","fontSize":26,"strokeColor":"#2c68c9","id":"e7"},{"type":"text","x":95,"y":326,"text":"Little or no web text, dictionary entries, UniMorph paradigms or tools for most varieties; under 40K parallel pairs.","fontSize":21,"strokeColor":"#1e1e1e","id":"e8"},{"type":"rectangle","x":70,"y":394,"width":1460,"height":106,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":95,"y":408,"text":"3 · Labels and scripts are part of the problem","fontSize":26,"strokeColor":"#6a45c9","id":"e10"},{"type":"text","x":95,"y":448,"text":"Macrolanguage codes, contested dialect status and inconsistent Unicode hide varieties from pipelines.","fontSize":21,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":70,"y":516,"width":1460,"height":106,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e12"},{"type":"text","x":95,"y":530,"text":"4 · Persian needs new tests, the rest need first tests","fontSize":26,"strokeColor":"#2f8a3d","id":"e13"},{"type":"text","x":95,"y":570,"text":"Persian is saturating on standard tasks; cultural and pragmatic competence is open.","fontSize":21,"strokeColor":"#1e1e1e","id":"e14"},{"type":"rectangle","x":70,"y":638,"width":1460,"height":106,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e15"},{"type":"text","x":95,"y":652,"text":"5 · Small contributions go far","fontSize":26,"strokeColor":"#b5690b","id":"e16"},{"type":"text","x":95,"y":692,"text":"Tagged web text, FLORES+ sentences, one native benchmark per variety.","fontSize":21,"strokeColor":"#1e1e1e","id":"e17"},{"type":"text","x":70,"y":775,"text":"sigiranic.github.io  ·  github.com/sigiranic/sigiranic.github.io","fontSize":21,"strokeColor":"#6b6f76","fontFamily":8,"id":"e18"},{"type":"text","x":1516.9,"y":856.8,"text":"24","fontSize":18,"strokeColor":"#adb5bd","id":"e19"}]