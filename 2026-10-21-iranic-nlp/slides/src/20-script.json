[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Same letter, different bytes","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":108,"text":"Script heterogeneity: a concrete source of silent failures","fontSize":26,"strokeColor":"#6b6f76","id":"e2"},{"type":"text","x":72,"y":14,"text":"PART VI · CHALLENGES AND PRIORITIES","fontSize":17,"strokeColor":"#c2410c","id":"e3"},{"type":"text","x":70,"y":210,"text":"yeh","fontSize":26,"strokeColor":"#6b6f76","id":"e4"},{"type":"rectangle","x":190,"y":170,"width":130,"height":120,"strokeColor":"#ced4da","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e5"},{"type":"text","x":238.5,"y":192.5,"text":"ی","fontSize":60,"strokeColor":"#1e1e1e","id":"e6"},{"type":"text","x":340,"y":214,"text":"U+06CC Farsi yeh","fontSize":21,"strokeColor":"#1e1e1e","fontFamily":8,"id":"e7"},{"type":"text","x":640,"y":214,"text":"≠","fontSize":40,"strokeColor":"#c2410c","id":"e8"},{"type":"rectangle","x":720,"y":170,"width":130,"height":120,"strokeColor":"#ced4da","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":768.5,"y":192.5,"text":"ي","fontSize":60,"strokeColor":"#1e1e1e","id":"e10"},{"type":"text","x":870,"y":214,"text":"U+064A Arabic yeh","fontSize":21,"strokeColor":"#1e1e1e","fontFamily":8,"id":"e11"},{"type":"text","x":70,"y":360,"text":"kaf","fontSize":26,"strokeColor":"#6b6f76","id":"e12"},{"type":"rectangle","x":190,"y":320,"width":130,"height":120,"strokeColor":"#ced4da","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e13"},{"type":"text","x":238.5,"y":342.5,"text":"ک","fontSize":60,"strokeColor":"#1e1e1e","id":"e14"},{"type":"text","x":340,"y":364,"text":"U+06A9 keheh","fontSize":21,"strokeColor":"#1e1e1e","fontFamily":8,"id":"e15"},{"type":"text","x":640,"y":364,"text":"≠","fontSize":40,"strokeColor":"#c2410c","id":"e16"},{"type":"rectangle","x":720,"y":320,"width":130,"height":120,"strokeColor":"#ced4da","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e17"},{"type":"text","x":768.5,"y":342.5,"text":"ك","fontSize":60,"strokeColor":"#1e1e1e","id":"e18"},{"type":"text","x":870,"y":364,"text":"U+0643 Arabic kaf","fontSize":21,"strokeColor":"#1e1e1e","fontFamily":8,"id":"e19"},{"type":"text","x":70,"y":480,"text":"In practice, ya and kaf code points differ across Persian, Pashto and Dari text, so string matching, deduplication\nand tokenization break without any error message. (Code points shown here as an illustration.)","fontSize":20,"strokeColor":"#6b6f76","id":"e20"},{"type":"rectangle","x":1180,"y":160,"width":350,"height":290,"strokeColor":"#e8590c","backgroundColor":"#fff1e8","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e21"},{"type":"text","x":1202,"y":176,"text":"More of the same","fontSize":25,"strokeColor":"#c2410c","id":"e22"},{"type":"text","x":1202,"y":221.2,"text":"• ZWNJ inside Persian\n  compounds\n• right-to-left mixed\n  with Latin text\n• Kurmanji in Latin,\n  Arabic or Cyrillic","fontSize":20,"strokeColor":"#1e1e1e","id":"e23"},{"type":"rectangle","x":70,"y":560,"width":1460,"height":150,"strokeColor":"#ced4da","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e24"},{"type":"text","x":95,"y":575,"text":"Scripts in use","fontSize":24,"strokeColor":"#495057","id":"e25"},{"type":"text","x":95,"y":615,"text":"About a dozen scripts across the family, most only historical. Living varieties use Perso-Arabic, Latin and\nCyrillic, often in parallel; Tajik uses Cyrillic only. Priority: one shared Iranic normalization library.","fontSize":21,"strokeColor":"#1e1e1e","id":"e26"},{"type":"rectangle","x":70,"y":745,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e27"},{"type":"text","x":404.5,"y":760.8,"text":"Normalize before you train, or related varieties look unrelated.","fontSize":26,"strokeColor":"#1e1e1e","id":"e28"},{"type":"text","x":70,"y":857.4,"text":"Computationally Invisible (SilkRoadNLP submission), §7 (script heterogeneity)","fontSize":17,"strokeColor":"#6b6f76","id":"e29"},{"type":"text","x":1515.4,"y":856.8,"text":"20","fontSize":18,"strokeColor":"#adb5bd","id":"e30"}]