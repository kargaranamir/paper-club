   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1  Persian: over 600M pairs\n   (web crawls, subtitles,\n   NLLB-200)\n\n2  Kurdish: about 511K\n   (Kurdish Parallel Corpus,\n   plus SMOL and PARME)\n\n3  everyone else: under 40K\n   in total; Balochi: 110",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1  Persian: over 600M pairs\n   (web crawls, subtitles,\n   NLLB-200)\n\n2  Kurdish: about 511K\n   (Kurdish Parallel Corpus,\n   plus SMOL and PARME)\n\n3  everyone else: under 40K\n   in total; Balochi: 110",
   "autoResize": true,
   "lineHeight": 1.25
