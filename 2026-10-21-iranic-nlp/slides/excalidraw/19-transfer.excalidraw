  {
   "id": "e14",
   "type": "text",
   "x": 95,
   "y": 530,
   "width": 993.3035888671875,
   "height": 110,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aE",
   "roundness": null,
   "seed": 758395797,
   "version": 1,
   "versionNonce": 1596811139,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• cross-lingual transfer runs almost entirely through Persian or English as pivots\n• a multilingual model that covers Persian does not cover Dari unless Dari data was included\n• tokenizers are calibrated for high-resource languages and over-segment related varieties\n• systematic intra-family transfer studies are still lacking",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "• cross-lingual transfer runs almost entirely through Persian or English as pivots\n• a multilingual model that covers Persian does not cover Dari unless Dari data was included\n• tokenizers are calibrated for high-resource languages and over-segment related varieties\n• systematic intra-family transfer studies are still lacking",
   "autoResize": true,
   "lineHeight": 1.25
  },
