   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "At least one natively written\nbenchmark per variety.\n\nShared tasks are the most\nplausible way to get them.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "At least one natively written\nbenchmark per variety.\n\nShared tasks are the most\nplausible way to get them.",
