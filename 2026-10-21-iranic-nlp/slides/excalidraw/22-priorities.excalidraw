   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Put Iranic text on the open web,\nin identifiable form.\n\nWeb crawls feed every corpus;\nuntagged or mistagged text is\ninvisible to LID-filtered\npipelines.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Put Iranic text on the open web,\nin identifiable form.\n\nWeb crawls feed every corpus;\nuntagged or mistagged text is\ninvisible to LID-filtered\npipelines.",
   "autoResize": true,
   "lineHeight": 1.25
  },
