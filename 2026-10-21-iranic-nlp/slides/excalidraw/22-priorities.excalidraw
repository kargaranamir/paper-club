   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "About 2K sentences per variety and an open pull-request process: the bottleneck is people, not\ninfrastructure. The lesson from African NLP: community shared tasks and data hubs catalyse progress.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "About 2K sentences per variety and an open pull-request process: the bottleneck is people, not\ninfrastructure. The lesson from African NLP: community shared tasks and data hubs catalyse progress.",
   "autoResize": true,
   "lineHeight": 1.25
  },
