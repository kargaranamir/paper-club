   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Contribute to FLORES+ / OLDI.\n\nFLORES+ grew from about 200\nto 230 varieties, but still has\nthe same 6 Iranic ones as\nFLORES-200: pes, prs, tgk,\nckb, kmr, pbt.",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Contribute to FLORES+ / OLDI.\n\nFLORES+ grew from about 200\nto 230 varieties, but still has\nthe same 6 Iranic ones as\nFLORES-200: pes, prs, tgk,\nckb, kmr, pbt.",
   "autoResize": true,
   "lineHeight": 1.25
  },
