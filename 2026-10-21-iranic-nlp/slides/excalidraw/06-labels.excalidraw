   "versionNonce": 1079133160,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Laki: a Kurdish dialect to some, a separate language to others.  Bakhtiari: its own code, yet Persian speakers\nsometimes treat all Luri as Persian.  These choices decide what data is labelled and who gets tools.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Laki: a Kurdish dialect to some, a separate language to others.  Bakhtiari: its own code, yet Persian speakers\nsometimes treat all Luri as Persian.  These choices decide what data is labelled and who gets tools.",
   "autoResize": true,
   "lineHeight": 1.25
  },
