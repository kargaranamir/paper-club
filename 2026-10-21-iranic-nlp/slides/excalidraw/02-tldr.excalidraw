   "index": "a7",
   "roundness": null,
   "seed": 169531510,
   "version": 1,
   "versionNonce": 1044549475,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A systematic survey:\n\n• 5,878 candidate papers,\n  2020 – May 2026\n• LLM filter + annotation\n  (Qwen3.5-9B), checked by\n  two of us\n• 495 papers kept\n• audit of corpora, Wikipedia,\n  morphology, LID, parallel data",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A systematic survey:\n\n• 5,878 candidate papers,\n  2020 – May 2026\n• LLM filter + annotation\n  (Qwen3.5-9B), checked by\n  two of us\n• 495 papers kept\n• audit of corpora, Wikipedia,\n  morphology, LID, parallel data",
   "autoResize": true,
   "lineHeight": 1.25
  },
