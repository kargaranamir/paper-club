   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Where does NLP stand for the\nIranic language family?\n\n• 101 ISO 639-3 coded varieties\n• over 200 million speakers\n• from the Caucasus to Xinjiang,\n  from Russia to Oman\n• four living branches",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Where does NLP stand for the\nIranic language family?\n\n• 101 ISO 639-3 coded varieties\n• over 200 million speakers\n• from the Caucasus to Xinjiang,\n  from Russia to Oman\n• four living branches",
   "autoResize": true,
   "lineHeight": 1.25
  },
