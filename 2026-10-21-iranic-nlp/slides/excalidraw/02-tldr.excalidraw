  {
   "id": "e10",
   "type": "text",
   "x": 1082,
   "y": 230,
   "width": 425.50164794921875,
   "height": 312.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
