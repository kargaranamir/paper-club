   "index": "aA",
   "roundness": null,
   "seed": 691285321,
   "version": 1,
   "versionNonce": 1193508318,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Severe imbalance:\n\n• Persian: 394 papers (80%)\n• Pashto: 51M speakers, 29 papers\n• Balochi: 9M speakers, 4 papers\n• most varieties: nothing found\n\nPersian itself is saturating on\nstandard tasks; the rest need\ntheir first benchmark.",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Severe imbalance:\n\n• Persian: 394 papers (80%)\n• Pashto: 51M speakers, 29 papers\n• Balochi: 9M speakers, 4 papers\n• most varieties: nothing found\n\nPersian itself is saturating on\nstandard tasks; the rest need\ntheir first benchmark.",
   "autoResize": true,
   "lineHeight": 1.25
  },
