   "versionNonce": 216127000,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• classification-style tasks\n  dominate: sentiment alone\n  has 116 papers\n\n• generation and dialogue\n  have about 10 each\n\n• most attention goes to\n  Persian in every task\n\n• for non-Persian varieties,\n  machine translation is the\n  most active area",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "• classification-style tasks\n  dominate: sentiment alone\n  has 116 papers\n\n• generation and dialogue\n  have about 10 each\n\n• most attention goes to\n  Persian in every task\n\n• for non-Persian varieties,\n  machine translation is the\n  most active area",
   "autoResize": true,
   "lineHeight": 1.25
  },
