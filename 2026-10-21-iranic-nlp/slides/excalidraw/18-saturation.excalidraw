  {
   "id": "e11",
   "type": "text",
   "x": 95,
   "y": 550,
   "width": 1079.5657958984375,
   "height": 82.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aB",
   "roundness": null,
   "seed": 674507702,
   "version": 1,
   "versionNonce": 1595972496,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TaarofBench: LLMs score 40–48% below native Persian speakers on taarof scenarios.\nFrontier models do well on factual recall but show gaps in cultural knowledge and pragmatic judgment\n(Khayyam, FarsEval-PKBETS, ELAB). Taarof is absent from all existing evaluation frameworks.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "TaarofBench: LLMs score 40–48% below native Persian speakers on taarof scenarios.\nFrontier models do well on factual recall but show gaps in cultural knowledge and pragmatic judgment\n(Khayyam, FarsEval-PKBETS, ELAB). Taarof is absent from all existing evaluation frameworks.",
   "autoResize": true,
   "lineHeight": 1.25
  },
