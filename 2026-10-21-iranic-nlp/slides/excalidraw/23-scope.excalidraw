   "versionNonce": 642085297,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• we searched indexed venues in English;\n  Persian-language journals are a natural\n  next addition to the live index\n\n• LLM-assisted screening, checked by people;\n  a recall audit of the filter is future work\n\n• the NLP levels summarise resources at a\n  glance; a scoring rule would make them\n  reproducible\n\n• paper counts show attention, not quality,\n  and reflect sanctions and access limits",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "• we searched indexed venues in English;\n  Persian-language journals are a natural\n  next addition to the live index\n\n• LLM-assisted screening, checked by people;\n  a recall audit of the filter is future work\n\n• the NLP levels summarise resources at a\n  glance; a scoring rule would make them\n  reproducible\n\n• paper counts show attention, not quality,\n  and reflect sanctions and access limits",
   "autoResize": true,
   "lineHeight": 1.25
  },
