   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In practice, ya and kaf code points differ across Persian, Pashto and Dari text, so string matching, deduplication\nand tokenization break without any error message. (Code points shown here as an illustration.)",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "In practice, ya and kaf code points differ across Persian, Pashto and Dari text, so string matching, deduplication\nand tokenization break without any error message. (Code points shown here as an illustration.)",
   "autoResize": true,
   "lineHeight": 1.25
  },
