   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "How do reasoning-enabled models behave?\n\nDoes MaxFlip transfer to unseen targets?\n\nCan a model resist bad evidence while\nstill accepting a valid correction?\n\nHow do rates change on a common\neligible subset?",
   "fontSize": 28,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "How do reasoning-enabled models behave?\n\nDoes MaxFlip transfer to unseen targets?\n\nCan a model resist bad evidence while\nstill accepting a valid correction?\n\nHow do rates change on a common\neligible subset?",
   "autoResize": true,
   "lineHeight": 1.25
  },
