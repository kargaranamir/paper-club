[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"What the design controls, and what can still vary","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"DISCUSSION","fontSize":17,"strokeColor":"#2c68c9","id":"e2"},{"type":"rectangle","x":70,"y":180,"width":700,"height":500,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":94,"y":202,"text":"Controlled comparisons","fontSize":32,"strokeColor":"#2f8a3d","id":"e4"},{"type":"text","x":94,"y":265,"text":"Question, target and wrong option\nheld within-item\n\nBlind vs self uses the same argument\n\nTemperature and reasoning-mode setup\nheld fixed\n\nCross condition fixes k = 10","fontSize":28,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":830,"y":180,"width":700,"height":500,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":854,"y":202,"text":"Remaining variation","fontSize":32,"strokeColor":"#b5690b","id":"e7"},{"type":"text","x":854,"y":265,"text":"Changing k regenerates the argument\n\nA different source changes content\nas well as source identity\n\nEligibility differs across models\n\nAttribution adds a persuasive cue","fontSize":28,"strokeColor":"#1e1e1e","id":"e8"},{"type":"rectangle","x":70,"y":770,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":254.6,"y":785.8,"text":"The design isolates specific comparisons; it does not identify every causal mechanism.","fontSize":26,"strokeColor":"#1e1e1e","id":"e10"},{"type":"text","x":70,"y":857.4,"text":"Who Flips? arXiv:2606.16011v2 | §§3–4; reviewer interpretation distinguished in notes","fontSize":17,"strokeColor":"#6b6f76","id":"e11"},{"type":"text","x":1516.5,"y":856.8,"text":"23","fontSize":18,"strokeColor":"#adb5bd","id":"e12"}]