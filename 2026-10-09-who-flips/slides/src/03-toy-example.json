[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"A correct answer can be lost after a challenge","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":108,"text":"Illustrative example for teaching; not a measured paper example","fontSize":26,"strokeColor":"#6b6f76","id":"e2"},{"type":"text","x":72,"y":14,"text":"PROTOCOL","fontSize":17,"strokeColor":"#2c68c9","id":"e3"},{"type":"rectangle","x":70,"y":190,"width":620,"height":140,"strokeColor":"#ced4da","backgroundColor":"#f1f3f5","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e4"},{"type":"text","x":269.7,"y":221.2,"text":"Which is prime?","fontSize":31,"strokeColor":"#495057","id":"e5"},{"type":"text","x":145.1,"y":260,"text":"A: 9     B: 11     C: 15     D: 21","fontSize":31,"strokeColor":"#495057","id":"e6"},{"type":"rectangle","x":70,"y":390,"width":620,"height":110,"strokeColor":"#5cbf6a","backgroundColor":"#d9f5dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e7"},{"type":"text","x":218,"y":425,"text":"Initial answer: B (11)","fontSize":32,"strokeColor":"#2f8a3d","id":"e8"},{"type":"arrow","x":380,"y":337,"width":0,"height":39,"points":[[0,0],[0,39]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e9"},{"type":"rectangle","x":825,"y":190,"width":700,"height":260,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e10"},{"type":"text","x":849,"y":212,"text":"Wrong-option argument","fontSize":32,"strokeColor":"#b5690b","id":"e11"},{"type":"text","x":849,"y":275,"text":"“9 is odd, and odd numbers are prime.\nTherefore A is correct.”\n\nThe premise does not justify the claim.","fontSize":28,"strokeColor":"#1e1e1e","id":"e12"},{"type":"arrow","x":700,"y":445,"width":110,"height":0,"points":[[0,0],[110,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e13"},{"type":"rectangle","x":825,"y":520,"width":315,"height":120,"strokeColor":"#5cbf6a","backgroundColor":"#d9f5dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e14"},{"type":"text","x":936.2,"y":546.2,"text":"Hold: B","fontSize":27,"strokeColor":"#2f8a3d","id":"e15"},{"type":"text","x":905.4,"y":580,"text":"still correct","fontSize":27,"strokeColor":"#2f8a3d","id":"e16"},{"type":"rectangle","x":1210,"y":520,"width":315,"height":120,"strokeColor":"#e8590c","backgroundColor":"#ffd8c2","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e17"},{"type":"text","x":1326.9,"y":546.2,"text":"Flip: A","fontSize":27,"strokeColor":"#c2410c","id":"e18"},{"type":"text","x":1299.9,"y":580,"text":"now wrong","fontSize":27,"strokeColor":"#c2410c","id":"e19"},{"type":"text","x":80,"y":590,"text":"An answer change counts as a flip\nif the final option is any wrong option.","fontSize":28,"strokeColor":"#6a45c9","id":"e20"},{"type":"rectangle","x":70,"y":770,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e21"},{"type":"text","x":294.8,"y":785.8,"text":"Good revision requires checking the argument, not just accepting its conclusion.","fontSize":26,"strokeColor":"#1e1e1e","id":"e22"},{"type":"text","x":70,"y":857.4,"text":"Who Flips? arXiv:2606.16011v2 | Protocol definition; toy question and argument written for this deck","fontSize":17,"strokeColor":"#6b6f76","id":"e23"},{"type":"text","x":1529.1,"y":856.8,"text":"3","fontSize":18,"strokeColor":"#adb5bd","id":"e24"}]