[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"The results have a specific scope","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"DISCUSSION","fontSize":17,"strokeColor":"#2c68c9","id":"e2"},{"type":"rectangle","x":70,"y":180,"width":700,"height":510,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":94,"y":202,"text":"Limits stated by the authors","fontSize":32,"strokeColor":"#b5690b","id":"e4"},{"type":"text","x":94,"y":265,"text":"MMLU only\n\nOne challenge per exchange\n\nModel-generated English arguments\n\nNo tested mitigation\n\nNo incorrect-to-correct revision study","fontSize":29,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":830,"y":180,"width":700,"height":510,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":854,"y":202,"text":"Questions for follow-up","fontSize":32,"strokeColor":"#6a45c9","id":"e7"},{"type":"text","x":854,"y":265,"text":"How do reasoning-enabled models behave?\n\nDoes MaxFlip transfer to unseen targets?\n\nCan a model resist bad evidence while\nstill accepting a valid correction?\n\nHow do rates change on a common\neligible subset?","fontSize":28,"strokeColor":"#1e1e1e","id":"e8"},{"type":"rectangle","x":70,"y":770,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":227.4,"y":785.8,"text":"Resistance to wrong arguments is valuable; blanket refusal to revise would not be enough.","fontSize":26,"strokeColor":"#1e1e1e","id":"e10"},{"type":"text","x":70,"y":857.4,"text":"Wh