[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Resistance and persuasive errors are separate roles","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"CROSS-MODEL RESULTS","fontSize":17,"strokeColor":"#2c68c9","id":"e2"},{"type":"rectangle","x":70,"y":180,"width":700,"height":430,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":94,"y":202,"text":"EP: susceptibility as a target","fontSize":32,"strokeColor":"#2c68c9","id":"e4"},{"type":"text","x":94,"y":265,"text":"Average a target column,\nexcluding the diagonal.\n\nHow often do other models’\narguments flip this target?\n\nLower EP means more resistance.","fontSize":30,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":830,"y":180,"width":700,"height":430,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":854,"y":202,"text":"EA: efficacy as a source","fontSize":32,"strokeColor":"#b5690b","id":"e7"},{"type":"text","x":854,"y":265,"text":"Average a source row,\nexcluding the diagonal.\n\nHow often does this source’s\nwrong argument flip other models?\n\nHigher EA means more effective errors.","fontSize":30,"strokeColor":"#1e1e1e","id":"e8"},{"type":"text","x":80,"y":670,"text":"Llama-3.1-8B: EP about 99%, EA about 24% (paper’s rounded summary).","fontSize":28,"strokeColor":"#1e1e1e","id":"e9"},{"type":"rectangle","x":70,"y":770,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e10"},{"type":"text","x":240.5,"y":785.8,"text":"The strongest sources of wrong arguments can also be among the most stable targets.","fontSize":26,"strokeColor":"#1e1e1e","id":"e11"},{"type":"text","x":70,"y":857.4,"text":"Who Flips? arXiv:2606.16011v2 | Definition 5.3; §5.6; Figure 5","fontSize":17,"strokeColor":"#6b6f76","id":"e12"},{"type":"text","x":1521,"y":856.8,"text":"19","fontSize":18,"strokeColor":"#adb5bd","id":"e13"}]