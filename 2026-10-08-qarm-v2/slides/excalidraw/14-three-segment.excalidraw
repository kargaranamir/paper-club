   "index": "b2K",
   "roundness": null,
   "seed": 918211693,
   "version": 1,
   "versionNonce": 1997512798,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "QARM V2 (arXiv:2602.08559), §3.1.2, Figure 3. Also: gradient cache for large batches; warm start anneals QA→input attention to 0",
   "fontSize": 17,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
