   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Training: loss = contrastive (4) + next-token (3), in one pass.\nWhy: QA sees only <EMB>, so the item information must flow through m.\nUse: <EMB> never sees QA, so at inference run input + <EMB> and read m.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Training: loss = contrastive (4) + next-token (3), in one pass.\nWhy: QA sees only <EMB>, so the item information must flow through m.\nUse: <EMB> never sees QA, so at inference run input + <EMB> and read m.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e206",
   "type": "text",
   "x": 70,
   "y": 857.4,
   "width": 1103.0767822265625,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#6b6f76",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
