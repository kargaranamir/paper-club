   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Revenue grows faster than\ncost in ads (+4.873% vs\n+3.942%).\n\nShopping#2 gains most on\nall three metrics.\n\nNo confidence intervals\nor traffic sizes are given.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Revenue grows faster than\ncost in ads (+4.873% vs\n+3.942%).\n\nShopping#2 gains most on\nall three metrics.\n\nNo confidence intervals\nor traffic sizes are given.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e34",
