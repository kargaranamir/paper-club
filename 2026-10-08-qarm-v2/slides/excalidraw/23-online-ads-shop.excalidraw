   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "For comparison, QARM (2024) on Shopping: GMV +2.296% (#1) and +1.568% (#2), measured against\na different, earlier production model.",
