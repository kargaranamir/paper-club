   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "§3.2: K = 8192, 13 FSQ dims, L = 2.\n13 binary dims → 2¹³ = 8192 codes.\nBut round(2·σ) gives 3 values per dim.\n§4.5 runs everything as '3 × 4096'.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "§3.2: K = 8192, 13 FSQ dims, L = 2.\n13 binary dims → 2¹³ = 8192 codes.\nBut round(2·σ) gives 3 values per dim.\n§4.5 runs everything as '3 × 4096'.",
   "autoResize": true,
   "lineHeight": 1.25
  },
