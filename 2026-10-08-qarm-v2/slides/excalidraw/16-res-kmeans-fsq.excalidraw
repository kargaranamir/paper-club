   "updated": 1,
   "link": null,
   "locked": false,
   "text": "M¹ = M − NearestRep(M, C¹)        C² = Kmeans(M¹, K)\nM² = M¹ − NearestRep(M¹, C²)\nZ  = round( L · sigmoid(M² W) ),   W ∈ R^(d×13),  L = 2\nfit on N > 10,000,000 sampled item embeddings (d = 3,000+)",
   "fontSize": 22,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "M¹ = M − NearestRep(M, C¹)        C² = Kmeans(M¹, K)\nM² = M¹ − NearestRep(M¹, C²)\nZ  = round( L · sigmoid(M² W) ),   W ∈ R^(d×13),  L = 2\nfit on N > 10,000,000 sampled item embeddings (d = 3,000+)",
   "autoResize": true,
   "lineHeight": 1.25
  },
