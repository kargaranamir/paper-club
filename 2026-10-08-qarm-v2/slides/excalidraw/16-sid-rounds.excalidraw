   "seed": 808875749,
   "version": 1,
   "versionNonce": 733804979,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Offline: K-means on the LLM\nembeddings of 10M+ items\n→ K centroids.\n\nK = 8,192 in the method section,\n4,096 in the experiments.\n\nc¹ = number of the item's\nnearest centroid.\n\nSame c¹ → broadly similar,\nroughly the same category.",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Offline: K-means on the LLM\nembeddings of 10M+ items\n→ K centroids.\n\nK = 8,192 in the method section,\n4,096 in the experiments.\n\nc¹ = number of the item's\nnearest centroid.\n\nSame c¹ → broadly similar,\nroughly the same category.",
   "autoResize": true,
   "lineHeight": 1.25
  },
