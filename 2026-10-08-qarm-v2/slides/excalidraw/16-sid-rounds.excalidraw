  {
   "id": "e21",
   "type": "text",
   "x": 92,
   "y": 314,
   "width": 366.3439636230469,
   "height": 345,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
