   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aW",
   "roundness": null,
   "seed": 926466177,
   "version": 1,
   "versionNonce": 274153223,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FSQ ignores where items are dense, so it spreads rare items over many different codes. That is the point of round 3.",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "FSQ ignores where items are dense, so it spreads rare items over many different codes. That is the point of round 3.",
   "autoResize": true,
   "lineHeight": 1.25
  },
