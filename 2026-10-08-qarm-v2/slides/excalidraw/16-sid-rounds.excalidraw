   "index": "aP",
   "roundness": null,
   "seed": 741765273,
   "version": 1,
   "versionNonce": 1404269774,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Subtract that centroid. What\nremains is the residual: how this\nitem differs from its cluster's\ncentre.\n\nSecond K-means on all items'\nresiduals → c² = the nearest\ncentroid there.\n\n(c¹, c²) = a finer group,\ne.g. category + usage.",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Subtract that centroid. What\nremains is the residual: how this\nitem differs from its cluster's\ncentre.\n\nSecond K-means on all items'\nresiduals → c² = the nearest\ncentroid there.\n\n(c¹, c²) = a finer group,\ne.g. category + usage.",
   "autoResize": true,
   "lineHeight": 1.25
  },
