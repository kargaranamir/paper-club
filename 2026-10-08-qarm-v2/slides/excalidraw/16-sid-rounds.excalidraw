  },
  {
   "id": "e25",
   "type": "text",
   "x": 567,
   "y": 314,
   "width": 359.3979797363281,
   "height": 316.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
