   "versionNonce": 1312498509,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "LLM item embeddings help a\nrecommender only a little:\n\n• their notion of 'similar' is\n  not the business notion\n  (representation unmatch)\n\n• cached embeddings are frozen,\n  so the ranker cannot learn them\n  (representation unlearning)",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "LLM item embeddings help a\nrecommender only a little:\n\n• their notion of 'similar' is\n  not the business notion\n  (representation unmatch)\n\n• cached embeddings are frozen,\n  so the ranker cannot learn them\n  (representation unlearning)",
   "autoResize": true,
   "lineHeight": 1.25
  },
