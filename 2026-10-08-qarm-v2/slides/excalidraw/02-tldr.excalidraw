   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Online A/B, multi-week:\n• ads revenue +4.873%\n• shopping GMV +1.0 to +5.6%\n\nOffline:\n• GAUC +0.05 to +1.10 points\n• SID collision 77.92% → 32.39%\n• retrieval HR@200 (click)\n  7.77% → 12.5%",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Online A/B, multi-week:\n• ads revenue +4.873%\n• shopping GMV +1.0 to +5.6%\n\nOffline:\n• GAUC +0.05 to +1.10 points\n• SID collision 77.92% → 32.39%\n• retrieval HR@200 (click)\n  7.77% → 12.5%",
