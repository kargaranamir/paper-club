   "versionNonce": 1044549475,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GSU (retrieval):\n• a reasoning LLM filters the\n  item pairs used for alignment\n• one LLM, three segments:\n  contrastive + next-token loss\n\nESU (ranking):\n• 2 × Res-Kmeans + 1 × FSQ\n  → semantic IDs, fewer collisions",
   "fontSize": 25,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GSU (retrieval):\n• a reasoning LLM filters the\n  item pairs used for alignment\n• one LLM, three segments:\n  contrastive + next-token loss\n\nESU (ranking):\n• 2 × Res-Kmeans + 1 × FSQ\n  → semantic IDs, fewer collisions",
   "autoResize": true,
   "lineHeight": 1.25
  },
