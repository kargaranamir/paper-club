  },
  {
   "id": "e19",
   "type": "text",
   "x": 95,
   "y": 662,
   "width": 1174.93603515625,
   "height": 82.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aJ",
   "roundness": null,
   "seed": 808728654,
   "version": 1,
   "versionNonce": 1328862103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A new item has no interactions yet, so its ID embedding is random: it cannot beat old, hot items.\nOnce an item is no longer distributed, everything its embedding learned is thrown away ('knowledge isolation').\nAn LLM reads the title and the images, so it knows what a new item is on day one.",
   "fontSize": 22,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A new item has no interactions yet, so its ID embedding is random: it cannot beat old, hot items.\nOnce an item is no longer distributed, everything its embedding learned is thrown away ('knowledge isolation').\nAn LLM reads the title and the images, so it knows what a new item is on day one.",
   "autoResize": true,
   "lineHeight": 1.25
  },
