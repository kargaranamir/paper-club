   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Also: sequences are not deduplicated. In live streaming the top-100 interactions contain only 23 unique authors\non average, and repeats carry signal (watch time, time of day). Deduplication lowered offline AUC.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Also: sequences are not deduplicated. In live streaming the top-100 interactions contain only 23 unique authors\non average, and repeats carry signal (watch time, time of day). Deduplication lowered offline AUC.",
   "autoResize": true,
   "lineHeight": 1.25
  },
