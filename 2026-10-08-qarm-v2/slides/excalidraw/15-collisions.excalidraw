  {
   "id": "e879",
   "type": "text",
   "x": 1170,
   "y": 230,
   "width": 334.3815002441406,
   "height": 183.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "bDB",
   "roundness": null,
   "seed": 1334010493,
   "version": 1,
   "versionNonce": 181656461,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "K-means minimises the distance\nto the nearest centroid only.\n\nHere 9 of 16 centroids sit in the\ndashed circle, 13% of the area.\nTail items far out share a few\ncentroids → same semantic ID.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "K-means minimises the distance\nto the nearest centroid only.\n\nHere 9 of 16 centroids sit in the\ndashed circle, 13% of the area.\nTail items far out share a few\ncentroids → same semantic ID.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e880",
   "type": "text",
   "x": 1170,
   "y": 520,
   "width": 314.7466125488281,
   "height": 105,
   "angle": 0,
   "strokeColor": "#2c68c9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "bDC",
   "roundness": null,
   "seed": 1046378209,
   "version": 1,
   "versionNonce": 1907684601,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FSQ rounds each dimension to\nfixed levels: the grid does not\ndepend on the data, so sparse\nregions keep their own cells.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "FSQ rounds each dimension to\nfixed levels: the grid does not\ndepend on the data, so sparse\nregions keep their own cells.",
   "autoResize": true,
   "lineHeight": 1.25
  },
