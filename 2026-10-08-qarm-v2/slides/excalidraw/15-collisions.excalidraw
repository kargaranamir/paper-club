   "index": "bDE",
   "roundness": null,
   "seed": 1079933447,
   "version": 1,
   "versionNonce": 2042251328,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "In QARM's 3-level Res-Kmeans, more than 30% of semantic IDs map to several items (Shopping).",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "In QARM's 3-level Res-Kmeans, more than 30% of semantic IDs map to several items (Shopping).",
   "autoResize": true,
   "lineHeight": 1.25
  },
