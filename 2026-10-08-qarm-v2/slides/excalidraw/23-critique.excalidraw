   "updated": 1,
   "link": null,
   "locked": false,
   "text": "• deployed in ads, shopping and live\n  streaming; multi-week A/B tests\n\n• reusable ideas: an LLM as a data\n  filter, a three-segment mask, a\n  hybrid quantizer\n\n• measures SID collisions directly\n  instead of only end metrics",
   "fontSize": 24,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "• deployed in ads, shopping and live\n  streaming; multi-week A/B tests\n\n• reusable ideas: an LLM as a data\n  filter, a three-segment mask, a\n  hybrid quantizer\n\n• measures SID collisions directly\n  instead of only end metrics",
   "autoResize": true,
   "lineHeight": 1.25
