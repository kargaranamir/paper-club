   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "SIM-hard: same tag\nSIM-soft / TWIN:\nsimilar ID embedding\n\nQARM V2:\nGSU → LLM embedding\nESU → semantic IDs",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SIM-hard: same tag\nSIM-soft / TWIN:\nsimilar ID embedding\n\nQARM V2:\nGSU → LLM embedding\nESU → semantic IDs",
   "autoResize": true,
   "lineHeight": 1.25
  },
