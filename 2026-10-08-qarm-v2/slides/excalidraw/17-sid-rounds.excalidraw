  {
   "id": "e20",
   "type": "text",
   "x": 135.1,
   "y": 785.6,
   "width": 1324.109619140625,
   "height": 28.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
