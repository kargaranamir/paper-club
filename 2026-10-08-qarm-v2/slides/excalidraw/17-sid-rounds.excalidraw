   "versionNonce": 1328023460,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "FSQ instead of K-means",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "FSQ instead of K-means",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e17",
   "type": "text",
   "x": 1042,
   "y": 262,
   "width": 384.95098876953125,
   "height": 287.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aH",
   "roundness": null,
   "seed": 708062940,
   "version": 1,
   "versionNonce": 1864760173,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Subtract the second centroid →\nsecond residual. Then FSQ:\n\n1. multiply by a learned matrix W:\n    3,000+ numbers → 13\n2. squash each into 0–1 (sigmoid),\n    scale by L = 2, round\n3. 13 small integers, read together\n    as one code c³, like a\n    13-digit number",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Subtract the second centroid →\nsecond residual. Then FSQ:\n\n1. multiply by a learned matrix W:\n    3,000+ numbers → 13\n2. squash each into 0–1 (sigmoid),\n    scale by L = 2, round\n3. 13 small integers, read together\n    as one code c³, like a\n    13-digit number",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e18",
   "type": "text",
