   "versionNonce": 775813381,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Turn it into semantic IDs that the ranker learns end-to-end.  QARM: frozen feature +0.02 AUC, as codes +0.18.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Turn it into semantic IDs that the ranker learns end-to-end.  QARM: frozen feature +0.02 AUC, as codes +0.18.",
   "autoResize": true,
   "lineHeight": 1.25
  },
