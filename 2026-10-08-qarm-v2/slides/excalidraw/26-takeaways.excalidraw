   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A reasoning LLM rejects 10%+ of Item2Item and 70%+ of User2Item pairs.  Click HR@200: 7.77% → 12.5%.",
   "fontSize": 21,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A reasoning LLM rejects 10%+ of Item2Item and 70%+ of User2Item pairs.  Click HR@200: 7.77% → 12.5%.",
   "autoResize": true,
   "lineHeight": 1.25
  },
