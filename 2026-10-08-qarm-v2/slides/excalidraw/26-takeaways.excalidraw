   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1 · A frozen LLM embedding is not enough; make it learnable",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1 · A frozen LLM embedding is not enough; make it learnable",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e5",
   "type": "text",
   "x": 95,
   "y": 208,
   "width": 1160.5389404296875,
   "height": 26.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
