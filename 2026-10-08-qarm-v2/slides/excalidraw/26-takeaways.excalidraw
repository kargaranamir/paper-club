   "text": "2 · Align the LLM to business similarity, and clean the pairs first",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2 · Align the LLM to business similarity, and clean the pairs first",
