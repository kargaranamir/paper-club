   "versionNonce": 1328023460,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "not affordable. Every lifelong model therefore first cuts the history down.",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "not affordable. Every lifelong model therefore first cuts the history down.",
