   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One ranking model serves ads, shopping and live streaming. It predicts CTR, CVR, gifts, follows …",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One ranking model serves ads, shopping and live streaming. It predicts CTR, CVR, gifts, follows …",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e15",
   "type": "text",
   "x": 70,
   "y": 480,
   "width": 1230.2432861328125,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aF",
   "roundness": null,
   "seed": 741618178,
   "version": 1,
   "versionNonce": 925559284,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It should use the whole history, but scoring 100,000 items per candidate in streaming training is",
   "fontSize": 26,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It should use the whole history, but scoring 100,000 items per candidate in streaming training is",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "e16",
   "type": "text",
   "x": 70,
   "y": 518,
   "width": 949.1309814453125,
