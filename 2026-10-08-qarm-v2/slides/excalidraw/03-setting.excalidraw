  {
   "id": "e14",
   "type": "text",
   "x": 70,
   "y": 430,
   "width": 1235.703125,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
