  },
  {
   "id": "e19",
   "type": "text",
   "x": 95,
   "y": 662,
   "width": 1169.5499267578125,
   "height": 57.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
