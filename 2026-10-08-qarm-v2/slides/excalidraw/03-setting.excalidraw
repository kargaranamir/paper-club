   "index": "aJ",
   "roundness": null,
   "seed": 808728654,
   "version": 1,
   "versionNonce": 1328862103,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Items are videos, live streams and products with titles, images, OCR and speech. An LLM can read them.\nThe question of both papers: how do we turn that understanding into something the ranker can use?",
   "fontSize": 23,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Items are videos, live streams and products with titles, images, OCR and speech. An LLM can read them.\nThe question of both papers: how do we turn that understanding into something the ranker can use?",
   "autoResize": true,
   "lineHeight": 1.25
  },
