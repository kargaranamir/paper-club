[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Takeaways","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART V · DISCUSSION","fontSize":17,"strokeColor":"#6b6f76","id":"e2"},{"type":"rectangle","x":70,"y":150,"width":1460,"height":106,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":95,"y":164,"text":"1 · A frozen LLM embedding is not enough; make it learnable","fontSize":26,"strokeColor":"#2c68c9","id":"e4"},{"type":"text","x":95,"y":208,"text":"Turn it into semantic IDs that the ranker learns end-to-end.  QARM: frozen feature +0.02 AUC, as codes +0.18.","fontSize":21,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":70,"y":272,"width":1460,"height":106,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":95,"y":286,"text":"2 · Align the LLM to business similarity, and clean the pairs first","fontSize":26,"strokeColor":"#b5690b","id":"e7"},{"type":"text","x":95,"y":330,"text":"A reasoning LLM rejects 10%+ of Item2Item and 70%+ of User2Item pairs.  Click HR@200: 7.77% → 12.5%.","fontSize":21,"strokeColor":"#1e1e1e","id":"e8"},{"type":"rectangle","x":70,"y":394,"width":1460,"height":106,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":95,"y":408,"text":"3 · One LLM can be an embedding model and a generator at once","fontSize":26,"strokeColor":"#2f8a3d","id":"e10"},{"type":"text","x":95,"y":452,"text":"Three-segment mask: QA sees only <EMB>, so the item embedding m must carry the item's information.","fontSize":21,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":70,"y":516,"width":1460,"height":106,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e12"},{"type":"text","x":95,"y":530,"text":"4 · K-means for coarse levels, FSQ for the last level","fontSize":26,"strokeColor":"#6a45c9","id":"e13"},{"type":"text","x":95,"y":574,"text":"Collision 77.92% → 32.39%, items per SID 129 → 2.5; but better embeddings alone already gave 8.4 items per SID.","fontSize":21,"strokeColor":"#1e1e1e","id":"e14"},{"type":"rectangle","x":70,"y":638,"width":1460,"height":106,"strokeColor":"#e8590c","backgroundColor":"#fff1e8","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e15"},{"type":"text","x":95,"y":652,"text":"5 · The gains are largest where IDs are weakest","fontSize":26,"strokeColor":"#c2410c","id":"e16"},{"type":"text","x":95,"y":696,"text":"Cold-start live streams: click +3.231% vs +0.611% for the rest.  Ads revenue +4.873%, shopping GMV up to +5.612%.","fontSize":21,"strokeColor":"#1e1e1e","id":"e17"},{"type":"text","x":70,"y":775,"text":"Open question: which of the four changes buys the online gains? The paper has no ablation on ranking metrics.","fontSize":22,"strokeColor":"#6b6f76","id":"e18"},{"type":"text","x":70,"y":857.4,"text":"QARM (arXiv:2411.11739), Table 1; QARM V2 (arXiv:2602.08559), Tables 5–9 and §3","fontSize":17,"strokeColor":"#6b6f76","id":"e19"},{"type":"text","x":1517.4,"y":856.8,"text":"27","fontSize":18,"strokeColor":"#adb5bd","id":"e20"}]