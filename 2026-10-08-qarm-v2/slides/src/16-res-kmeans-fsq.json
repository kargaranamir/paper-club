Size":22,"strokeColor":"#6a45c9","id":"e13"},{"type":"arrow","x":924,"y":265,"width":46,"height":0,"points":[[0,0],[46,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e14"},{"type":"rectangle","x":975,"y":220,"width":300,"height":90,"strokeColor":"#5b9be6","backgroundColor":"#b8d6fb","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e15"},{"type":"text","x":1061.5,"y":237.5,"text":"level 3: FSQ","fontSize":22,"strokeColor":"#2c68c9","id":"e16"},{"type":"text","x":1048.7,"y":265,"text":"on residual M²","fontSize":22,"strokeColor":"#2c68c9","id":"e17"},{"type":"arrow","x":1279,"y":265,"width":46,"height":0,"points":[[0,0],[46,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e18"},{"type":"rectangle","x":1330,"y":220,"width":200,"height":90,"strokeColor":"#5cbf6a","backgroundColor":"#d9f5dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e19"},{"type":"text","x":1398.1,"y":237.5,"text":"SID =","fontSize":22,"strokeColor":"#2f8a3d","id":"e20"},{"type":"text","x":1371.5,"y":265,"text":"(c¹, c², c³)","fontSize":22,"strokeColor":"#2f8a3d","id":"e21"},{"type":"text","x":448.4,"y":320,"text":"c¹","fontSize":22,"strokeColor":"#6b6f76","id":"e22"},{"type":"text","x":773.4,"y":320,"text":"c²","fontSize":22,"strokeColor":"#6b6f76","id":"e23"},{"type":"text","x":1113.4,"y":320,"text":"c³","fontSize":22,"strokeColor":"#6b6f76","id":"e24"},{"type":"rectangle","x":325,"y":360,"width":595,"height":70,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e25"},{"type":"text","x":405.5,"y":381.9,"text":"category and usage: adaptive to the data","fontSize":21,"strokeColor":"#6a45c9","id":"e26"},{"type":"rectangle","x":975,"y":360,"width":300,"height":70,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e27"},{"type":"text","x":1028.8,"y":381.9,"text":"item-specific detail","fontSize":21,"strokeColor":"#2c68c9","id":"e28"},{"type":"rectangle","x":70,"y":470,"width":900,"height":230,"strokeColor":"#ced4da","backgroundColor":"#f1f3f5","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e29"},{"type":"text","x":95,"y":485,"text":"as in the paper","fontSize":20,"strokeColor":"#6b6f76","id":"e30"},{"type":"text","x":95,"y":520,"text":"M¹ = M − NearestRep(M, C¹)        C² = Kmeans(M¹, K)\nM² = M¹ − NearestRep(M¹, C²)\nZ  = round( L · sigmoid(M² W) ),   W ∈ R^(d×13),  L = 2\nfit on N > 10,000,000 sampled item embeddings (d = 3,000+)","fontSize":22,"strokeColor":"#1e1e1e","fontFamily":8,"id":"e31"},{"type":"rectangle","x":1010,"y":470,"width":520,"height":230,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e32"},{"type":"text","x":1030,"y":485,"text":"Check the sizes","fontSize":24,"strokeColor":"#b5690b","id":"e33"},{"type":"text","x":1030,"y":530,"text":"§3.2: K = 8192, 13 FSQ dims, L = 2.\n13 binary dims → 2¹³ = 8192 codes.\nBut round(2·σ) gives 3 values per dim.\n§4.5 runs everything as '3 × 4096'.","fontSize":21,"strokeColor":"#1e1e1e","id":"e34"},{"type":"text","x":70,"y":857.4,"text":"QARM V2 (arXiv:2602.08559), §1 and §3.2 (Eq. 2–3)","fontSize":17,"strokeColor":"#6b6f76","id":"e35"},{"type":"text","x":1520.8,"y":856.8,"text":"16","fontSize":18,"strokeColor":"#adb5bd","id":"e36"}]