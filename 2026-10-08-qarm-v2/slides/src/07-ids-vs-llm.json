[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Why not just IDs? Three weaknesses of ID embeddings","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART I · BACKGROUND","fontSize":17,"strokeColor":"#495057","id":"e2"},{"type":"rectangle","x":70,"y":170,"width":1370,"height":95,"strokeColor":"#ced4da","backgroundColor":"#f1f3f5","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e3"},{"type":"text","x":414,"y":202.5,"text":"ID-based RecSys (weak)","fontSize":24,"strokeColor":"#495057","id":"e4"},{"type":"text","x":934,"y":202.5,"text":"LLM (strong)","fontSize":24,"strokeColor":"#495057","id":"e5"},{"type":"text","x":84,"y":297.5,"text":"Information units","fontSize":24,"strokeColor":"#1e1e1e","id":"e6"},{"type":"text","x":414,"y":282.5,"text":"billions of user / item IDs,\ngrowing every day","fontSize":24,"strokeColor":"#b5690b","id":"e7"},{"type":"text","x":934,"y":297.5,"text":"a fixed token vocabulary","fontSize":24,"strokeColor":"#2c68c9","id":"e8"},{"type":"rectangle","x":70,"y":360,"width":1370,"height":95,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e9"},{"type":"text","x":84,"y":392.5,"text":"Knowledge storage","fontSize":24,"strokeColor":"#1e1e1e","id":"e10"},{"type":"text","x":414,"y":377.5,"text":"in ID embeddings; one\ncross-attention layer","fontSize":24,"strokeColor":"#b5690b","id":"e11"},{"type":"text","x":934,"y":377.5,"text":"in a deep transformer\n(40+ layers)","fontSize":24,"strokeColor":"#2c68c9","id":"e12"},{"type":"text","x":84,"y":487.5,"text":"Generalization","fontSize":24,"strokeColor":"#1e1e1e","id":"e13"},{"type":"text","x":414,"y":472.5,"text":"needs real-time streaming\ntraining; stops → drops","fontSize":24,"strokeColor":"#b5690b","id":"e14"},{"type":"text","x":934,"y":472.5,"text":"train once; stable\nlong-term inference","fontSize":24,"strokeColor":"#2c68c9","id":"e15"},{"type":"arrow","x":70,"y":550,"width":1370,"height":0,"points":[[0,0.0],[1370,0.0]],"strokeColor":"#adb5bd","strokeWidth":1,"endArrowhead":null,"startArrowhead":null,"roughness":0,"id":"e16"},{"type":"rectangle","x":70,"y":600,"width":1460,"height":170,"strokeColor":"#ced4da","backgroundColor":"#f1f3f5","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e17"},{"type":"text","x":95,"y":618,"text":"Long-tail problem, made concrete","fontSize":25,"strokeColor":"#1e1e1e","id":"e18"},{"type":"text","x":95,"y":662,"text":"A new item has no interactions yet, so its ID embedding is random: it cannot beat old, hot items.\nOnce an item is no longer distributed, everything its embedding learned is thrown away ('knowledge isolation').\nAn LLM reads the title and the images, so it knows what a new item is on day one.","fontSize":22,"strokeColor":"#1e1e1e","id":"e19"},{"type":"text","x":70,"y":857.4,"text":"QARM V2 (arXiv:2602.08559), §1 and Figure 1. Vocabulary size: '< 20,000 token IDs' in the text, '~1e5' in Figure 1","fontSize":17,"strokeColor":"#6b6f76","id":"e20"},{"type":"text","x":1530,"y":856.8,"text":"7","fontSize":18,"strokeColor":"#adb5bd","id":"e21"}]