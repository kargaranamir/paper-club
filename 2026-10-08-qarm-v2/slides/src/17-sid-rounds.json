[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Building a semantic ID in three rounds","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":108,"text":"Each round describes what the previous rounds missed","fontSize":26,"strokeColor":"#6b6f76","id":"e2"},{"type":"text","x":72,"y":14,"text":"PART III · ESU SIDE: RES-KMEANSFSQ SEMANTIC IDS","fontSize":17,"strokeColor":"#6a45c9","id":"e3"},{"type":"rectangle","x":70,"y":160,"width":445,"height":580,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e4"},{"type":"text","x":92,"y":176,"text":"Round 1 · coarse","fontSize":27,"strokeColor":"#6a45c9","id":"e5"},{"type":"text","x":92,"y":216,"text":"K-means","fontSize":21,"strokeColor":"#6b6f76","id":"e6"},{"type":"text","x":92,"y":262,"text":"Offline: K-means on the LLM\nembeddings of 10M+ items\n→ K centroids.\n\nK = 8,192 in the method section,\n4,096 in the experiments.\n\nc¹ = number of the item's\nnearest centroid.\n\nSame c¹ → broadly similar,\nroughly the same category.","fontSize":23,"strokeColor":"#1e1e1e","id":"e7"},{"type":"arrow","x":518,"y":200,"width":24,"height":0,"points":[[0,0],[24,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e8"},{"type":"rectangle","x":545,"y":160,"width":445,"height":580,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e9"},{"type":"text","x":567,"y":176,"text":"Round 2 · finer","fontSize":27,"strokeColor":"#6a45c9","id":"e10"},{"type":"text","x":567,"y":216,"text":"K-means on the residual","fontSize":21,"strokeColor":"#6b6f76","id":"e11"},{"type":"text","x":567,"y":262,"text":"Subtract that centroid. What\nremains is the residual: how this\nitem differs from its cluster's\ncentre.\n\nSecond K-means on all items'\nresiduals → c² = the nearest\ncentroid there.\n\n(c¹, c²) = a finer group,\ne.g. category + usage.","fontSize":23,"strokeColor":"#1e1e1e","id":"e12"},{"type":"arrow","x":993,"y":200,"width":24,"height":0,"points":[[0,0],[24,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e13"},{"type":"rectangle","x":1020,"y":160,"width":510,"height":580,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e14"},{"type":"text","x":1042,"y":176,"text":"Round 3 · item detail","fontSize":27,"strokeColor":"#2c68c9","id":"e15"},{"type":"text","x":1042,"y":216,"text":"FSQ instead of K-means","fontSize":21,"strokeColor":"#6b6f76","id":"e16"},{"type":"text","x":1042,"y":262,"text":"Subtract the second centroid →\nsecond residual. Then FSQ:\n\n1. multiply by a learned matrix W:\n    3,000+ numbers → 13\n2. squash each into 0–1 (sigmoid),\n    scale by L = 2, round\n3. 13 small integers, read together\n    as one code c³, like a\n    13-digit number","fontSize":23,"strokeColor":"#1e1e1e","id":"e17"},{"type":"text","x":1042,"y":672,"text":"SID = (c¹, c², c³)","fontSize":28,"strokeColor":"#2f8a3d","id":"e18"},{"type":"rectangle","x":70,"y":765,"width":1460,"height":70,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e19"},{"type":"text","x":135.1,"y":785.6,"text":"FSQ ignores where items are dense, so it spreads rare items over many different codes. That is the point of round 3.","fontSize":23,"strokeColor":"#1e1e1e","id":"e20"},{"type":"text","x":70,"y":857.4,"text":"QARM V2 (arXiv:2602.08559), §3.2 (Eq. 2–3) and §4.5","fontSize":17,"strokeColor":"#6b6f76","id":"e21"},{"type":"text","x":1522.3,"y":856.8,"text":"17","fontSize":18,"strokeColor":"#adb5bd","id":"e22"}]