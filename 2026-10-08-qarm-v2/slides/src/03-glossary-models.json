[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Glossary 1 · models and building blocks","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"rectangle","x":70,"y":150,"width":1460,"height":52,"strokeColor":"#ced4da","backgroundColor":"#f1f3f5","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e2"},{"type":"text","x":84,"y":163.5,"text":"term","fontSize":20,"strokeColor":"#495057","id":"e3"},{"type":"text","x":384,"y":163.5,"text":"meaning","fontSize":20,"strokeColor":"#495057","id":"e4"},{"type":"text","x":84,"y":215.5,"text":"GSU","fontSize":20,"strokeColor":"#2c68c9","id":"e5"},{"type":"text","x":384,"y":215.5,"text":"General Search Unit: a cheap first step that picks the K history items most related to the target","fontSize":20,"strokeColor":"#1e1e1e","id":"e6"},{"type":"rectangle","x":70,"y":254,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e7"},{"type":"text","x":84,"y":267.5,"text":"ESU","fontSize":20,"strokeColor":"#2c68c9","id":"e8"},{"type":"text","x":384,"y":267.5,"text":"Exact Search Unit: an expensive, trained step that attends over those K items","fontSize":20,"strokeColor":"#1e1e1e","id":"e9"},{"type":"text","x":84,"y":319.5,"text":"SIM","fontSize":20,"strokeColor":"#2c68c9","id":"e10"},{"type":"text","x":384,"y":319.5,"text":"Search-based Interest Model (Alibaba, 2020): introduced the GSU → ESU split for long histories","fontSize":20,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":70,"y":358,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e12"},{"type":"text","x":84,"y":371.5,"text":"SIM-hard / -soft","fontSize":20,"strokeColor":"#2c68c9","id":"e13"},{"type":"text","x":384,"y":371.5,"text":"GSU by same category tag (hard) or by similar learned ID embeddings (soft)","fontSize":20,"strokeColor":"#1e1e1e","id":"e14"},{"type":"text","x":84,"y":423.5,"text":"TWIN, TWIN V2","fontSize":20,"strokeColor":"#2c68c9","id":"e15"},{"type":"text","x":384,"y":423.5,"text":"Kuaishou's lifelong models (2023, 2024): the GSU reuses the ESU's attention scores","fontSize":20,"strokeColor":"#1e1e1e","id":"e16"},{"type":"rectangle","x":70,"y":462,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e17"},{"type":"text","x":84,"y":475.5,"text":"DIN","fontSize":20,"strokeColor":"#2c68c9","id":"e18"},{"type":"text","x":384,"y":475.5,"text":"Deep Interest Network (Alibaba, 2018): attention over the user's most recent items","fontSize":20,"strokeColor":"#1e1e1e","id":"e19"},{"type":"text","x":84,"y":527.5,"text":"target attention","fontSize":20,"strokeColor":"#2c68c9","id":"e20"},{"type":"text","x":384,"y":527.5,"text":"attention where the candidate (target) item is the query and history items are keys","fontSize":20,"strokeColor":"#1e1e1e","id":"e21"},{"type":"rectangle","x":70,"y":566,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e22"},{"type":"text","x":84,"y":579.5,"text":"MoE","fontSize":20,"strokeColor":"#2c68c9","id":"e23"},{"type":"text","x":384,"y":579.5,"text":"Mixture of Experts: shared experts with per-task gates, one output per task (CTR, CVR, …)","fontSize":20,"strokeColor":"#1e1e1e","id":"e24"},{"type":"text","x":84,"y":631.5,"text":"Item2Item · Swing","fontSize":20,"strokeColor":"#2c68c9","id":"e25"},{"type":"text","x":384,"y":631.5,"text":"item–item similarity from co-clicks (Swing: users who clicked both items)","fontSize":20,"strokeColor":"#1e1e1e","id":"e26"},{"type":"rectangle","x":70,"y":670,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e27"},{"type":"text","x":84,"y":683.5,"text":"User2Item · two-tower","fontSize":20,"strokeColor":"#2c68c9","id":"e28"},{"type":"text","x":384,"y":683.5,"text":"a user encoder and an item encoder whose dot product scores user–item pairs","fontSize":20,"strokeColor":"#1e1e1e","id":"e29"},{"type":"text","x":84,"y":735.5,"text":"semantic ID (SID)","fontSize":20,"strokeColor":"#2c68c9","id":"e30"},{"type":"text","x":384,"y":735.5,"text":"a short tuple of discrete codes (c¹, c², c³) for an item, derived from its embedding","fontSize":20,"strokeColor":"#1e1e1e","id":"e31"},{"type":"rectangle","x":70,"y":774,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e32"},{"type":"text","x":84,"y":787.5,"text":"TIGER, OneRec","fontSize":20,"strokeColor":"#2c68c9","id":"e33"},{"type":"text","x":384,"y":787.5,"text":"generative recommenders that predict semantic IDs (Google 2023, Kuaishou 2025)","fontSize":20,"strokeColor":"#1e1e1e","id":"e34"},{"type":"arrow","x":70,"y":826,"width":1460,"height":0,"points":[[0,0.0],[1460,0.0]],"strokeColor":"#adb5bd","strokeWidth":1,"endArrowhead":null,"startArrowhead":null,"roughness":0,"id":"e35"},{"type":"text","x":70,"y":857.4,"text":"Definitions in plain words; see the speaker notes for the papers behind each term","fontSize":17,"strokeColor":"#6b6f76","id":"e36"},{"type":"text","x":1529.1,"y":856.8,"text":"3","fontSize":18,"strokeColor":"#adb5bd","id":"e37"}]