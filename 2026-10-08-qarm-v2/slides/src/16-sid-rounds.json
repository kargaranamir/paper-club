[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Res-KmeansFSQ: building a semantic ID in three rounds","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":108,"text":"Each round describes what the previous rounds missed","fontSize":26,"strokeColor":"#6b6f76","id":"e2"},{"type":"text","x":72,"y":14,"text":"PART III · ESU SIDE: RES-KMEANSFSQ SEMANTIC IDS","fontSize":17,"strokeColor":"#6a45c9","id":"e3"},{"type":"rectangle","x":70,"y":152,"width":194.8,"height":46,"strokeColor":"#5b9be6","backgroundColor":"#b8d6fb","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e4"},{"type":"text","x":86,"y":162.5,"text":"LLM embedding m","fontSize":20,"strokeColor":"#2c68c9","id":"e5"},{"type":"arrow","x":268.8,"y":175,"width":32,"height":0,"points":[[0.0,0],[32.0,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e6"},{"type":"rectangle","x":304.8,"y":152,"width":179.3,"height":46,"strokeColor":"#8a63e8","backgroundColor":"#e3dcfb","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e7"},{"type":"text","x":320.8,"y":162.5,"text":"1: K-means → c¹","fontSize":20,"strokeColor":"#6a45c9","id":"e8"},{"type":"arrow","x":488.1,"y":175,"width":32,"height":0,"points":[[0.0,0],[32.0,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e9"},{"type":"rectangle","x":524.1,"y":152,"width":297.1,"height":46,"strokeColor":"#8a63e8","backgroundColor":"#e3dcfb","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e10"},{"type":"text","x":540.1,"y":162.5,"text":"2: K-means on residual → c²","fontSize":20,"strokeColor":"#6a45c9","id":"e11"},{"type":"arrow","x":825.2,"y":175,"width":32,"height":0,"points":[[0.0,0],[32.0,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e12"},{"type":"rectangle","x":861.2,"y":152,"width":258.9,"height":46,"strokeColor":"#5b9be6","backgroundColor":"#b8d6fb","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e13"},{"type":"text","x":877.2,"y":162.5,"text":"3: FSQ on residual → c³","fontSize":20,"strokeColor":"#2c68c9","id":"e14"},{"type":"arrow","x":1124,"y":175,"width":32,"height":0,"points":[[0.0,0],[32.0,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e15"},{"type":"rectangle","x":1160,"y":152,"width":204.3,"height":46,"strokeColor":"#5cbf6a","backgroundColor":"#d9f5dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e16"},{"type":"text","x":1176,"y":162.5,"text":"SID = (c¹, c², c³)","fontSize":20,"strokeColor":"#2f8a3d","id":"e17"},{"type":"rectangle","x":70,"y":222,"width":445,"height":520,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e18"},{"type":"text","x":92,"y":236,"text":"Round 1 · coarse","fontSize":27,"strokeColor":"#6a45c9","id":"e19"},{"type":"text","x":92,"y":274,"text":"K-means","fontSize":21,"strokeColor":"#6b6f76","id":"e20"},{"type":"text","x":92,"y":314,"text":"Offline: K-means on the LLM\nembeddings of 10M+ items\n→ K centroids.\n\nK = 8,192 in the method section,\n4,096 in the experiments.\n\nc¹ = number of the item's\nnearest centroid.\n\nSame c¹ → broadly similar,\nroughly the same category.","fontSize":23,"strokeColor":"#1e1e1e","id":"e21"},{"type":"rectangle","x":545,"y":222,"width":445,"height":520,"strokeColor":"#8a63e8","backgroundColor":"#f3effd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e22"},{"type":"text","x":567,"y":236,"text":"Round 2 · finer","fontSize":27,"strokeColor":"#6a45c9","id":"e23"},{"type":"text","x":567,"y":274,"text":"K-means on the residual","fontSize":21,"strokeColor":"#6b6f76","id":"e24"},{"type":"text","x":567,"y":314,"text":"Subtract that centroid. What\nremains is the residual: how this\nitem differs from its cluster's\ncentre.\n\nSecond K-means on all items'\nresiduals → c² = the nearest\ncentroid there.\n\n(c¹, c²) = a finer group,\ne.g. category + usage.","fontSize":23,"strokeColor":"#1e1e1e","id":"e25"},{"type":"rectangle","x":1020,"y":222,"width":510,"height":520,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e26"},{"type":"text","x":1042,"y":236,"text":"Round 3 · item detail","fontSize":27,"strokeColor":"#2c68c9","id":"e27"},{"type":"text","x":1042,"y":274,"text":"FSQ instead of K-means","fontSize":21,"strokeColor":"#6b6f76","id":"e28"},{"type":"text","x":1042,"y":314,"text":"Subtract the second centroid →\nsecond residual. Then FSQ:\n\n1. multiply by a learned matrix W:\n    3,000+ numbers → 13\n2. squash each into 0–1 (sigmoid),\n    scale by L = 2, round\n3. 13 small integers, read together\n    as one code c³, like a\n    13-digit number","fontSize":23,"strokeColor":"#1e1e1e","id":"e29"},{"type":"text","x":1042,"y":640,"text":"As written, round(2·σ) gives 3 values per\ndim (3¹³ codes); binary dims would give\n2¹³ = 8,192. The paper does not say which.","fontSize":18,"strokeColor":"#b5690b","id":"e30"},{"type":"rectangle","x":70,"y":765,"width":1460,"height":70,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e31"},{"type":"text","x":135.1,"y":785.6,"text":"FSQ ignores where items are dense, so it spreads rare items over many different codes. That is the point of round 3.","fontSize":23,"strokeColor":"#1e1e1e","id":"e32"},{"type":"text","x":70,"y":857.4,"text":"QARM V2 (arXiv:2602.08559), §3.2 (Eq. 2–3) and §4.5","fontSize":17,"strokeColor":"#6b6f76","id":"e33"},{"type":"text","x":1520.8,"y":856.8,"text":"16","fontSize":18,"strokeColor":"#adb5bd","id":"e34"}]