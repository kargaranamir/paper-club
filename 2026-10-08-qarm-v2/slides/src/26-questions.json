[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Questions for the discussion","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART V · DISCUSSION","fontSize":17,"strokeColor":"#6b6f76","id":"e2"},{"type":"rectangle","x":70,"y":160,"width":60,"height":60,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":94,"y":172.5,"text":"1","fontSize":28,"strokeColor":"#1e1e1e","id":"e4"},{"type":"text","x":160,"y":158,"text":"Whose notion of 'related'?","fontSize":26,"strokeColor":"#1e1e1e","id":"e5"},{"type":"text","x":160,"y":198,"text":"The filter swaps exposure bias for the LLM's prior. When should a\nco-click the LLM finds unrelated still count as signal?","fontSize":21,"strokeColor":"#6b6f76","id":"e6"},{"type":"rectangle","x":70,"y":292,"width":60,"height":60,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e7"},{"type":"text","x":90.2,"y":304.5,"text":"2","fontSize":28,"strokeColor":"#1e1e1e","id":"e8"},{"type":"text","x":160,"y":290,"text":"Embeddings or quantizer?","fontSize":26,"strokeColor":"#1e1e1e","id":"e9"},{"type":"text","x":160,"y":330,"text":"V2 Res-Kmeans already cuts EdgeNum 15×. How much end-to-end gain\nis left for FSQ? Would a random hash on level 3 do as well?","fontSize":21,"strokeColor":"#6b6f76","id":"e10"},{"type":"rectangle","x":70,"y":424,"width":60,"height":60,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e11"},{"type":"text","x":91.5,"y":436.5,"text":"3","fontSize":28,"strokeColor":"#1e1e1e","id":"e12"},{"type":"text","x":160,"y":422,"text":"Is the third level semantic?","fontSize":26,"strokeColor":"#1e1e1e","id":"e13"},{"type":"text","x":160,"y":462,"text":"FSQ ignores the data distribution. Does c³ carry meaning, or is it a\ntie-breaker that makes SIDs unique?","fontSize":21,"strokeColor":"#6b6f76","id":"e14"},{"type":"rectangle","x":70,"y":556,"width":60,"height":60,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e15"},{"type":"text","x":91.8,"y":568.5,"text":"4","fontSize":28,"strokeColor":"#1e1e1e","id":"e16"},{"type":"text","x":160,"y":554,"text":"Three segments vs one <EMB>","fontSize":26,"strokeColor":"#1e1e1e","id":"e17"},{"type":"text","x":160,"y":594,"text":"The paper argues next-token loss protects the LLM. No experiment\ncompares it with a plain <EMB> token.","fontSize":21,"strokeColor":"#6b6f76","id":"e18"},{"type":"rectangle","x":70,"y":688,"width":60,"height":60,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e19"},{"type":"text","x":91.3,"y":700.5,"text":"5","fontSize":28,"strokeColor":"#1e1e1e","id":"e20"},{"type":"text","x":160,"y":686,"text":"Would this work outside Kuaishou?","fontSize":26,"strokeColor":"#1e1e1e","id":"e21"},{"type":"text","x":160,"y":726,"text":"Amazon Book: +0.76 AUC over SIM-soft. What is needed in data and\nLLM compute to see the online gains elsewhere?","fontSize":21,"strokeColor":"#6b6f76","id":"e22"},{"type":"text","x":1515.9,"y":856.8,"text":"26","fontSize":18,"strokeColor":"#adb5bd","id":"e23"}]