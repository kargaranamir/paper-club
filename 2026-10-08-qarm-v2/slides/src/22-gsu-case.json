[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"What the semantic GSU finds that the ID-based GSU does not","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART IV · RESULTS","fontSize":17,"strokeColor":"#2f8a3d","id":"e2"},{"type":"rectangle","x":70,"y":170,"width":1160,"height":66,"strokeColor":"#5cbf6a","backgroundColor":"#d9f5dc","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e3"},{"type":"text","x":84,"y":188,"text":"history sequence","fontSize":24,"strokeColor":"#2f8a3d","id":"e4"},{"type":"text","x":499,"y":188,"text":"Click (top 50)","fontSize":24,"strokeColor":"#2f8a3d","id":"e5"},{"type":"text","x":751.9,"y":188,"text":"Order (top 30)","fontSize":24,"strokeColor":"#2f8a3d","id":"e6"},{"type":"text","x":991,"y":188,"text":"Exposure (top 30)","fontSize":24,"strokeColor":"#2f8a3d","id":"e7"},{"type":"text","x":84,"y":254,"text":"Exclusive rate","fontSize":24,"strokeColor":"#1e1e1e","id":"e8"},{"type":"text","x":542.9,"y":254,"text":"63.6%","fontSize":24,"strokeColor":"#1e1e1e","id":"e9"},{"type":"text","x":803.9,"y":254,"text":"57.9%","fontSize":24,"strokeColor":"#1e1e1e","id":"e10"},{"type":"text","x":1065.4,"y":254,"text":"65.1%","fontSize":24,"strokeColor":"#1e1e1e","id":"e11"},{"type":"arrow","x":70,"y":302,"width":1160,"height":0,"points":[[0,0.0],[1160,0.0]],"strokeColor":"#adb5bd","strokeWidth":1,"endArrowhead":null,"startArrowhead":null,"roughness":0,"id":"e12"},{"type":"text","x":70,"y":330,"text":"Exclusive rate: share of retrieved history items that QARM V2 finds and the baseline GSU (SIM) does not.","fontSize":21,"strokeColor":"#6b6f76","id":"e13"},{"type":"rectangle","x":70,"y":400,"width":715,"height":200,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e14"},{"type":"text","x":95,"y":418,"text":"ID-based SIM","fontSize":25,"strokeColor":"#b5690b","id":"e15"},{"type":"text","x":95,"y":462,"text":"retrieves 'hard negatives': history items\nunrelated in category and meaning,\ne.g. jewellery for a phone-accessory target","fontSize":22,"strokeColor":"#1e1e1e","id":"e16"},{"type":"rectangle","x":815,"y":400,"width":715,"height":200,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e17"},{"type":"text","x":840,"y":418,"text":"QARM V2","fontSize":25,"strokeColor":"#2c68c9","id":"e18"},{"type":"text","x":840,"y":462,"text":"retrieved items stay in the target's\ncategory and meaning; often related but\nvisually dissimilar","fontSize":22,"strokeColor":"#1e1e1e","id":"e19"},{"type":"text","x":70,"y":660,"text":"Also: sequences are not deduplicated. In live streaming the top-100 interactions contain only 23 unique authors\non average, and repeats carry signal (watch time, time of day). Deduplication lowered offline AUC.","fontSize":21,"strokeColor":"#6b6f76","id":"e20"},{"type":"text","x":70,"y":857.4,"text":"QARM V2 (arXiv:2602.08559), Table 10, Figure 5 and §4.2","fontSize":17,"strokeColor":"#6b6f76","id":"e21"},{"type":"text","x":1514.8,"y":856.8,"text":"22","fontSize":18,"strokeColor":"#adb5bd","id":"e22"}]