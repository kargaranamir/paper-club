[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"The paper in one slide","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"rectangle","x":70,"y":160,"width":465,"height":545,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e2"},{"type":"text","x":92,"y":176,"text":"Problem","fontSize":32,"strokeColor":"#b5690b","id":"e3"},{"type":"text","x":92,"y":230,"text":"LLM item embeddings help a\nrecommender only a little:\n\n• their notion of 'similar' is\n  not the business notion\n  (representation unmatch)\n\n• cached embeddings are frozen,\n  so the ranker cannot learn them\n  (representation unlearning)","fontSize":25,"strokeColor":"#1e1e1e","id":"e4"},{"type":"rectangle","x":565,"y":160,"width":465,"height":545,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e5"},{"type":"text","x":587,"y":176,"text":"Two fixes","fontSize":32,"strokeColor":"#2c68c9","id":"e6"},{"type":"text","x":587,"y":230,"text":"GSU (retrieval):\n• a reasoning LLM filters the\n  item pairs used for alignment\n• one LLM, three segments:\n  contrastive + next-token loss\n\nESU (ranking):\n• 2 × Res-Kmeans + 1 × FSQ\n  → semantic IDs, fewer collisions","fontSize":25,"strokeColor":"#1e1e1e","id":"e7"},{"type":"rectangle","x":1060,"y":160,"width":465,"height":545,"strokeColor":"#5cbf6a","backgroundColor":"#effaf0","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e8"},{"type":"text","x":1082,"y":176,"text":"Evidence","fontSize":32,"strokeColor":"#2f8a3d","id":"e9"},{"type":"text","x":1082,"y":230,"text":"Online A/B, multi-week:\n• ads revenue +4.873%\n• shopping GMV +1.0 to +5.6%\n\nOffline:\n• GAUC +0.05 to +1.10 points\n• SID collision 77.92% → 32.39%\n• retrieval HR@200 (click)\n  7.77% → 12.5%","fontSize":25,"strokeColor":"#1e1e1e","id":"e10"},{"type":"rectangle","x":70,"y":735,"width":1460,"height":64,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e11"},{"type":"text","x":208.2,"y":750.8,"text":"An industrial paper: strong deployment evidence, few ablations, several loose ends to discuss.","fontSize":26,"strokeColor":"#1e1e1e","id":"e12"},{"type":"text","x":70,"y":857.4,"text":"QARM V2 (arXiv:2602.08559): abstract, Tables 5, 6, 8, 9","fontSize":17,"strokeColor":"#6b6f76","id":"e13"},{"type":"text","x":1527.4,"y":856.8,"text":"2","fontSize":18,"strokeColor":"#adb5bd","id":"e14"}]