[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Setting: Kuaishou, short video and live streaming","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":14,"text":"PART I · BACKGROUND","fontSize":17,"strokeColor":"#495057","id":"e2"},{"type":"rectangle","x":70,"y":165,"width":465,"height":220,"strokeColor":"#ced4da","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e3"},{"type":"text","x":198.7,"y":190,"text":"400M+","fontSize":64,"strokeColor":"#1e1e1e","id":"e4"},{"type":"text","x":200,"y":285,"text":"daily active users","fontSize":24,"strokeColor":"#1e1e1e","id":"e5"},{"type":"rectangle","x":565,"y":165,"width":465,"height":220,"strokeColor":"#ced4da","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e6"},{"type":"text","x":720,"y":190,"text":"10M+","fontSize":64,"strokeColor":"#1e1e1e","id":"e7"},{"type":"text","x":685.1,"y":285,"text":"new items uploaded","fontSize":24,"strokeColor":"#1e1e1e","id":"e8"},{"type":"text","x":741.2,"y":315,"text":"every day","fontSize":24,"strokeColor":"#1e1e1e","id":"e9"},{"type":"rectangle","x":1060,"y":165,"width":465,"height":220,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e10"},{"type":"text","x":1146.3,"y":190,"text":"100,000+","fontSize":64,"strokeColor":"#b5690b","id":"e11"},{"type":"text","x":1137.3,"y":285,"text":"interactions in the history","fontSize":24,"strokeColor":"#1e1e1e","id":"e12"},{"type":"text","x":1178.5,"y":315,"text":"of each active user","fontSize":24,"strokeColor":"#1e1e1e","id":"e13"},{"type":"text","x":70,"y":430,"text":"One ranking model serves ads, shopping and live streaming. It predicts CTR, CVR, gifts, follows …","fontSize":26,"strokeColor":"#1e1e1e","id":"e14"},{"type":"text","x":70,"y":480,"text":"It should use the whole history, but scoring 100,000 items per candidate in streaming training is","fontSize":26,"strokeColor":"#1e1e1e","id":"e15"},{"type":"text","x":70,"y":518,"text":"not affordable. Every lifelong model therefore first cuts the history down.","fontSize":26,"strokeColor":"#1e1e1e","id":"e16"},{"type":"rectangle","x":70,"y":600,"width":1460,"height":150,"strokeColor":"#5b9be6","backgroundColor":"#eaf2fd","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e17"},{"type":"text","x":95,"y":618,"text":"Where LLMs come in","fontSize":26,"strokeColor":"#2c68c9","id":"e18"},{"type":"text","x":95,"y":662,"text":"Items are videos, live streams and products with titles, images, OCR and speech. An LLM can read them.\nThe question of both papers: how do we turn that understanding into something the ranker can use?","fontSize":23,"strokeColor":"#1e1e1e","id":"e19"},{"type":"text","x":70,"y":857.4,"text":"QARM V2 (arXiv:2602.08559), §1 (\"tens of millions of fresh new items … every day\")","fontSize":17,"strokeColor":"#6b6f76","id":"e20"},{"type":"text","x":1529.1,"y":856.8,"text":"3","fontSize":18,"strokeColor":"#adb5bd","id":"e21"}]