[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"Glossary 2 · quantization, metrics and business terms","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"rectangle","x":70,"y":150,"width":1460,"height":52,"strokeColor":"#ced4da","backgroundColor":"#f1f3f5","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e2"},{"type":"text","x":84,"y":163.5,"text":"term","fontSize":20,"strokeColor":"#495057","id":"e3"},{"type":"text","x":384,"y":163.5,"text":"meaning","fontSize":20,"strokeColor":"#495057","id":"e4"},{"type":"text","x":84,"y":215.5,"text":"Res-Kmeans (RQ)","fontSize":20,"strokeColor":"#2c68c9","id":"e5"},{"type":"text","x":384,"y":215.5,"text":"residual K-means: cluster, subtract the centroid, cluster the remainder again, per level","fontSize":20,"strokeColor":"#1e1e1e","id":"e6"},{"type":"rectangle","x":70,"y":254,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e7"},{"type":"text","x":84,"y":267.5,"text":"VQ code (QARM)","fontSize":20,"strokeColor":"#2c68c9","id":"e8"},{"type":"text","x":384,"y":267.5,"text":"an item described by the IDs of its K nearest items in embedding space","fontSize":20,"strokeColor":"#1e1e1e","id":"e9"},{"type":"text","x":84,"y":319.5,"text":"FSQ","fontSize":20,"strokeColor":"#2c68c9","id":"e10"},{"type":"text","x":384,"y":319.5,"text":"Finite Scalar Quantization: project to a few dims, round each to fixed levels (no codebook)","fontSize":20,"strokeColor":"#1e1e1e","id":"e11"},{"type":"rectangle","x":70,"y":358,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e12"},{"type":"text","x":84,"y":371.5,"text":"collision · EdgeNum","fontSize":20,"strokeColor":"#2c68c9","id":"e13"},{"type":"text","x":384,"y":371.5,"text":"share of items sharing their SID with another item · items per SID on average","fontSize":20,"strokeColor":"#1e1e1e","id":"e14"},{"type":"text","x":84,"y":423.5,"text":"CTR · CVR · CTCVR","fontSize":20,"strokeColor":"#2c68c9","id":"e15"},{"type":"text","x":384,"y":423.5,"text":"P(click | shown) · P(buy | clicked) · P(click and buy | shown)","fontSize":20,"strokeColor":"#1e1e1e","id":"e16"},{"type":"rectangle","x":70,"y":462,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e17"},{"type":"text","x":84,"y":475.5,"text":"AUC","fontSize":20,"strokeColor":"#2c68c9","id":"e18"},{"type":"text","x":384,"y":475.5,"text":"probability that a random positive is scored above a random negative (50 = chance)","fontSize":20,"strokeColor":"#1e1e1e","id":"e19"},{"type":"text","x":84,"y":527.5,"text":"UAUC · GAUC","fontSize":20,"strokeColor":"#2c68c9","id":"e20"},{"type":"text","x":384,"y":527.5,"text":"AUC computed per user, then averaged (UAUC) or weighted by the user's samples (GAUC)","fontSize":20,"strokeColor":"#1e1e1e","id":"e21"},{"type":"rectangle","x":70,"y":566,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e22"},{"type":"text","x":84,"y":579.5,"text":"HR@K","fontSize":20,"strokeColor":"#2c68c9","id":"e23"},{"type":"text","x":384,"y":579.5,"text":"hit rate: the share of cases where a true item is among the top K retrieved","fontSize":20,"strokeColor":"#1e1e1e","id":"e24"},{"type":"text","x":84,"y":631.5,"text":"exposure · GMV","fontSize":20,"strokeColor":"#2c68c9","id":"e25"},{"type":"text","x":384,"y":631.5,"text":"how often items are shown · gross merchandise value, the money spent on orders","fontSize":20,"strokeColor":"#1e1e1e","id":"e26"},{"type":"rectangle","x":70,"y":670,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e27"},{"type":"text","x":84,"y":683.5,"text":"cold-start item","fontSize":20,"strokeColor":"#2c68c9","id":"e28"},{"type":"text","x":384,"y":683.5,"text":"a new item with (almost) no interactions yet, so its ID embedding is untrained","fontSize":20,"strokeColor":"#1e1e1e","id":"e29"},{"type":"text","x":84,"y":735.5,"text":"A/B test","fontSize":20,"strokeColor":"#2c68c9","id":"e30"},{"type":"text","x":384,"y":735.5,"text":"live traffic split: part of the users get the new model, the rest the production model","fontSize":20,"strokeColor":"#1e1e1e","id":"e31"},{"type":"rectangle","x":70,"y":774,"width":1460,"height":52,"strokeColor":"transparent","backgroundColor":"#f8f9fa","fillStyle":"solid","strokeWidth":1,"roughness":0,"id":"e32"},{"type":"text","x":84,"y":787.5,"text":"OCR · ASR · ViT","fontSize":20,"strokeColor":"#2c68c9","id":"e33"},{"type":"text","x":384,"y":787.5,"text":"text read from images · speech-to-text · Vision Transformer image encoder","fontSize":20,"strokeColor":"#1e1e1e","id":"e34"},{"type":"arrow","x":70,"y":826,"width":1460,"height":0,"points":[[0,0.0],[1460,0.0]],"strokeColor":"#adb5bd","strokeWidth":1,"endArrowhead":null,"startArrowhead":null,"roughness":0,"id":"e35"},{"type":"text","x":70,"y":857.4,"text":"WUAUC (Shopping#2) is a weighted variant of UAUC; the paper does not define its weights","fontSize":17,"strokeColor":"#6b6f76","id":"e36"},{"type":"text","x":1529.5,"y":856.8,"text":"4","fontSize":18,"strokeColor":"#adb5bd","id":"e37"}]