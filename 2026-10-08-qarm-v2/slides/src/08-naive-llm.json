[{"type":"cameraUpdate","width":1600,"height":1200,"x":0,"y":-150},{"type":"rectangle","id":"slidebg","x":0,"y":0,"width":1600,"height":900,"strokeColor":"#dee2e6","strokeWidth":1,"roughness":0,"backgroundColor":"#ffffff","fillStyle":"solid"},{"type":"text","x":70,"y":42,"text":"But plugging in LLM embeddings gives little","fontSize":46,"strokeColor":"#1e1e1e","id":"e1"},{"type":"text","x":72,"y":108,"text":"The common practice: cache one embedding per item, add it as a feature","fontSize":26,"strokeColor":"#6b6f76","id":"e2"},{"type":"text","x":72,"y":14,"text":"PART I · BACKGROUND","fontSize":17,"strokeColor":"#b5690b","id":"e3"},{"type":"rectangle","x":70,"y":170,"width":715,"height":470,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e4"},{"type":"text","x":95,"y":188,"text":"1 · Representation unmatch","fontSize":28,"strokeColor":"#b5690b","id":"e5"},{"type":"text","x":95,"y":240,"text":"Pre-training learns image–text matching, captions,\nQA. The ranker needs click and purchase similarity.","fontSize":22,"strokeColor":"#1e1e1e","id":"e6"},{"type":"rectangle","x":140,"y":360,"width":210,"height":60,"strokeColor":"#ced4da","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e7"},{"type":"text","x":183.2,"y":376.2,"text":"toothpaste","fontSize":22,"strokeColor":"#495057","id":"e8"},{"type":"text","x":187.3,"y":435,"text":"brush teeth","fontSize":20,"strokeColor":"#6b6f76","id":"e9"},{"type":"rectangle","x":460,"y":360,"width":210,"height":60,"strokeColor":"#ced4da","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e10"},{"type":"text","x":518.8,"y":376.2,"text":"ointment","fontSize":22,"strokeColor":"#495057","id":"e11"},{"type":"text","x":516.2,"y":435,"text":"treat skin","fontSize":20,"strokeColor":"#6b6f76","id":"e12"},{"type":"arrow","x":352,"y":390,"width":106,"height":0,"points":[[0,0],[106,0]],"strokeColor":"#e8a33d","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":"arrow","id":"e13"},{"type":"text","x":362.5,"y":335,"text":"look alike","fontSize":19,"strokeColor":"#b5690b","id":"e14"},{"type":"text","x":95,"y":500,"text":"Same tube packaging → close embeddings.\nDifferent usage → should be far apart.","fontSize":22,"strokeColor":"#1e1e1e","id":"e15"},{"type":"rectangle","x":815,"y":170,"width":715,"height":470,"strokeColor":"#e8a33d","backgroundColor":"#fdf0dc","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e16"},{"type":"text","x":840,"y":188,"text":"2 · Representation unlearning","fontSize":28,"strokeColor":"#b5690b","id":"e17"},{"type":"text","x":840,"y":240,"text":"A cached embedding is a fixed input. No gradient\nreaches it, so it cannot adapt to the ranking task\nor to the business as it drifts.","fontSize":22,"strokeColor":"#1e1e1e","id":"e18"},{"type":"rectangle","x":880,"y":400,"width":180,"height":60,"strokeColor":"#ced4da","backgroundColor":"#ffffff","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e19"},{"type":"text","x":913.5,"y":416.9,"text":"LLM vector","fontSize":21,"strokeColor":"#495057","id":"e20"},{"type":"arrow","x":1064,"y":430,"width":106,"height":0,"points":[[0,0],[106,0]],"strokeColor":"#1e1e1e","strokeWidth":2,"endArrowhead":"arrow","startArrowhead":null,"id":"e21"},{"type":"rectangle","x":1175,"y":400,"width":230,"height":60,"strokeColor":"#5b9be6","backgroundColor":"#b8d6fb","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e22"},{"type":"text","x":1222.8,"y":416.9,"text":"ranking model","fontSize":21,"strokeColor":"#2c68c9","id":"e23"},{"type":"text","x":1065.4,"y":365,"text":"no gradient","fontSize":19,"strokeColor":"#b5690b","id":"e24"},{"type":"arrow","x":1100,"y":400,"width":35,"height":60,"points":[[0,0],[35,60]],"strokeColor":"#e8a33d","strokeWidth":3,"endArrowhead":null,"startArrowhead":null,"id":"e25"},{"type":"rectangle","x":70,"y":670,"width":1460,"height":100,"strokeColor":"#1e1e1e","backgroundColor":"#fdf3c4","fillStyle":"solid","strokeWidth":2,"roundness":{"type":3},"id":"e26"},{"type":"text","x":382.5,"y":690,"text":"\"Our goal is not to recommend look-alike items users have already seen,","fontSize":24,"strokeColor":"#1e1e1e","id":"e27"},{"type":"text","x":330.2,"y":720,"text":"but to discover new items of interest expanded from their historical behaviors.\"","fontSize":24,"strokeColor":"#1e1e1e","id":"e28"},{"type":"text","x":70,"y":857.4,"text":"QARM V2 (arXiv:2602.08559), §1 (toothpaste / ointment example and quote)","fontSize":17,"strokeColor":"#6b6f76","id":"e29"},{"type":"text","x":1528.6,"y":856.8,"text":"8","fontSize":18,"strokeColor":"#adb5bd","id":"e30"}]